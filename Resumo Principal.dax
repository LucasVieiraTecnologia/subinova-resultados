Resumo Principal = 
-- =====================================================================================
--  RESUMO PRINCIPAL  ·  v5 (Mapa 3D Interativo de Minas Gerais + Modo Tela Cheia)
--  • Design institucional limpo (tipografia Segoe UI, números tabulares, ícones SVG,
--    paleta coesa por Diretoria, sem emojis decorativos).
--  • Gráfico 3D (Three.js) segmentado em 4 arcos por Diretoria (DPD, DCTT, DIPRO, DIAE).
--  • Filtro combinado por Diretoria, Município clicável e busca textual instantânea.
--  • Ordenação de cartões, subtotais em R$ por programa e rolagem isolada no visual.
-- =====================================================================================

VAR BuscaAtiva = ISFILTERED ( 'BuscaIndice'[Keyword] )
VAR TermosPesquisados = VALUES ( 'BuscaIndice'[Keyword] )
VAR TotalTermosPesquisados = COUNTROWS ( TermosPesquisados )

VAR ID_selecionados_AND =
    FILTER (
        CALCULATETABLE ( VALUES ( ProjetosCMunicipios[ID_Projeto] ) ),
        VAR ID_Atual = [ID_Projeto]
        VAR TermosDesteID =
            CALCULATETABLE (
                VALUES ( 'BuscaIndice'[Keyword] ),
                'BuscaIndice'[ID_Projeto] = ID_Atual,
                ALL ( 'BuscaIndice'[Keyword] )
            )
        RETURN
            NOT ( BuscaAtiva )
                || COUNTROWS ( INTERSECT ( TermosDesteID, TermosPesquisados ) ) >= TotalTermosPesquisados
    )

VAR TitulosFinais =
    CALCULATETABLE (
        VALUES ( ProjetosCMunicipios[Título da proposta] ),
        ProjetosCMunicipios[ID_Projeto] IN ID_selecionados_AND
    )

VAR MunicipiosFinais =
    CALCULATETABLE (
        VALUES ( ProjetosCMunicipios[Município] ),
        ProjetosCMunicipios[ID_Projeto] IN ID_selecionados_AND
    )

VAR MunicipiosLimpos =
    FILTER (
        MunicipiosFinais,
        NOT ISBLANK ( [Município] ) && LEN ( TRIM ( [Município] ) ) > 0
    )

VAR qAlysson    = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Alysson Paolinelli" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qCompete    = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "COMPETE MINAS" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qPCTI       = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "PCTI" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qPesqEmp    = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "PESQUISADOR NA EMPRESA" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qProInov    = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "PRÓ-INOVAÇÃO" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qAmbientes  = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "AMBIENTES PROMOTORES DE INOVAÇÃO" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qMaturidade = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "INCREMENTO DA MATURIDADE" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qTriplice   = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "TRÍPLICE HÉLICE APL" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qParques    = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "PARQUES TECNOLÓGICOS" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qTecpop     = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "TECPOP" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qCientista  = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Cientista Empreendedor" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qSEED       = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Seed" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qEventech   = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Eventech" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qCompeteEmp = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Compete Minas - Empresas" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qComeToMinas= COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Come To Minas" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qHubMg      = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "HubMG GOV" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qCdfResgate = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Cidades do Futuro + Hub Resgates" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qCdf        = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Cidades do Futuro" && [ID_Projeto] IN ID_selecionados_AND ) )
VAR qLab        = COUNTROWS ( FILTER ( ProjetosCMunicipios, [Projeto] = "Laboratórios Certificadores" && [ID_Projeto] IN ID_selecionados_AND ) )

VAR qDPD   = qAmbientes + qCientista + qLab + qParques + qTecpop
VAR qDCTT  = qAlysson + qCompete + qMaturidade + qPCTI + qPesqEmp + qProInov + qTriplice
VAR qDIPRO = qComeToMinas + qCompeteEmp + qEventech + qSEED
VAR qDIAE  = qCdf + qCdfResgate + qHubMg

VAR QuantidadeTotal = qDPD + qDCTT + qDIPRO + qDIAE

-- ===================== DETALHES (CARTÕES) =====================
-- Chaves data-k lidas pelo Excel/JS: mun, tit, num, area, coord, exec, valor

VAR BtnCopiar = "<button class='cp' type='button' title='Copiar projeto'><svg width='13' height='13' viewBox='0 0 24 24'><use href='#icp'/></svg></button>"

VAR DetalheAmbientes =
    CONCATENATEX (
        FILTER (
            ProjetosCMunicipios,
            [Projeto] = "AMBIENTES PROMOTORES DE INOVAÇÃO"
                && [ID_Projeto] IN ID_selecionados_AND
        ),
        VAR vTit    = IF ( ISBLANK ( [Título da proposta] ) || [Título da proposta] = "", "Sem título identificado", [Título da proposta] )
        VAR vMun    = IF ( ISBLANK ( [Município] ) || [Município] = "", "Não identificado", [Município] )
        VAR vMeso   = IF ( ISBLANK ( [Mesorregião] ) || [Mesorregião] = "", "Não identificado", [Mesorregião] )
        VAR vAno    = IF ( ISBLANK ( [Ano] ) || [Ano] = "" || [Ano] = "0", "Não identificado", "" & [Ano] )
        VAR vAPQ    = IF ( ISBLANK ( [APQ] ) || [APQ] = "", "Não se aplica", [APQ] )
        VAR vArea   = IF ( ISBLANK ( [Área de Conhecimento] ) || [Área de Conhecimento] = "", "Não identificado", [Área de Conhecimento] )
        VAR vCoord  = IF ( ISBLANK ( [Coordenador] ) || [Coordenador] = "", "Não identificado", [Coordenador] )
        VAR vExec   = IF ( ISBLANK ( [Executora] ) || [Executora] = "", "Não identificado", [Executora] )
        VAR vOrgao  = IF ( ISBLANK ( [Órgão estadual (Nome)] ) || [Órgão estadual (Nome)] = "", "N/A", [Órgão estadual (Nome)] )
        VAR vOrgaoHtml = IF ( vOrgao <> "N/A", "<div class='f'><b>Órgão Estadual</b><span data-k='orgao'>" & vOrgao & "</span></div>", "" )
        VAR vConc   = [Valor Concedente]
        VAR vApv    = [Valor Total Aprovado (com Contrapartida)]
        VAR rRaw    = [Resumo]
        VAR vResumo = IF ( ISBLANK ( rRaw ) || rRaw = "", "Não informado", IF ( rRaw = "NÃO SE APLICA", "Não se aplica", IF ( LEN ( rRaw ) > 100, LEFT ( rRaw, 97 ) & "...", rRaw ) ) )
        RETURN
            "<li class='card' data-dir='DPD' data-proj='Ambientes Promotores' data-conc='" & FORMAT ( vConc, "0.00", "en-US" ) & "' data-apv='" & FORMAT ( vApv, "0.00", "en-US" ) & "'>" &
                "<div class='card-h'><span class='card-t' data-k='tit'>" & vTit & "</span>" & BtnCopiar & "</div>" &
                "<div class='grid'>" &
                    "<div class='f'><b>Município</b><span data-k='mun'>" & vMun & "</span></div>" &
                    "<div class='f'><b>Mesorregião</b><span data-k='meso'>" & vMeso & "</span></div>" &
                    "<div class='f'><b>Ano</b><span data-k='ano'>" & vAno & "</span></div>" &
                    "<div class='f'><b>Edital / APQ</b><span data-k='num'>" & vAPQ & "</span></div>" &
                    "<div class='f'><b>Área</b><span data-k='area'>" & vArea & "</span></div>" &
                    "<div class='f'><b>Coordenador(a)</b><span data-k='coord'>" & vCoord & "</span></div>" &
                    "<div class='f full'><b>Executora / Proponente</b><span data-k='exec'>" & vExec & "</span></div>" &
                    vOrgaoHtml &
                "</div>" &
                "<div class='val'>" &
                    "<span>Valor Concedente</span><b data-k='valor'>" & FORMAT ( vConc, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                    "<span>Total c/ Contrapartida</span><b data-k='aprov'>" & FORMAT ( vApv, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                "</div>" &
                "<div class='f full card-resumo'><b>Resumo</b><span data-k='resumo'>" & vResumo & "</span></div>" &
            "</li>",
        ""
    )

VAR DetalheCientista =
    CONCATENATEX (
        FILTER (
            ProjetosCMunicipios,
            [Projeto] = "CIENTISTA EMPREENDEDOR"
                && [ID_Projeto] IN ID_selecionados_AND
