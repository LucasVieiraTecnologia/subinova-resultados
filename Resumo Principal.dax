                "<div class='card-h'><span class='card-t' data-k='tit'>" & vTit & "</span>" & BtnCopiar & "</div>" &
                "<div class='grid'>" &
                    "<div class='f'><b>Município</b><span data-k='mun'>" & vMun & "</span></div>" &
                    "<div class='f'><b>Mesorregião</b><span data-k='meso'>" & vMeso & "</span></div>" &
                    "<div class='f'><b>Ano</b><span data-k='ano'>" & vAno & "</span></div>" &
                    "<div class='f'><b>Edital / APQ</b><span data-k='num'>" & vAPQ & "</span></div>" &
                    "<div class='f'><b>Área</b><span data-k='area'>" & vArea & "</span></div>" &
                    "<div class='f'><b>Coordenador(a)</b><span data-k='coord'>" & vCoord & "</span></div>" &
                    "<div class='f full'><b>Executora / Proponente</b><span data-k='exec'>" & vExec & "</span></div>" &
                    vOrgaoHtml &
                "</div>" &
                "<div class='val'>" &
                    "<span>Valor Concedente</span><b data-k='valor'>" & FORMAT ( vConc, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                    "<span>Total c/ Contrapartida</span><b data-k='aprov'>" & FORMAT ( vApv, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                "</div>" &
                "<div class='f full card-resumo'><b>Resumo</b><span data-k='resumo'>" & vResumo & "</span></div>" &
            "</li>",
        ""
    )

