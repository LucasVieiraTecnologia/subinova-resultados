                    "<div class='f'><b>Ano</b><span data-k='ano'>" & vAno & "</span></div>" &
                    "<div class='f'><b>Edital / APQ</b><span data-k='num'>" & vAPQ & "</span></div>" &
                    "<div class='f'><b>Área</b><span data-k='area'>" & vArea & "</span></div>" &
                    "<div class='f'><b>Coordenador(a)</b><span data-k='coord'>" & vCoord & "</span></div>" &
                    "<div class='f full'><b>Executora / Proponente</b><span data-k='exec'>" & vExec & "</span></div>" &
                    vOrgaoHtml &
                "</div>" &
                "<div class='val'>" &
                    "<span>Valor Concedente</span><b data-k='valor'>" & FORMAT ( vConc, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                    "<span>Total c/ Contrapartida</span><b data-k='aprov'>" & FORMAT ( vApv, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                "</div>" &
                "<div class='f full card-resumo'><b>Resumo</b><span data-k='resumo'>" & vResumo & "</span></div>" &
            "</li>",
        ""
    )

VAR DetalheCdfResgates =
    CONCATENATEX (
        FILTER (
            ProjetosCMunicipios,
            [Projeto] = "CIDADES DO FUTURO + HUB RESGATES"
                && [ID_Projeto] IN ID_selecionados_AND
        ),
        VAR vTit    = IF ( ISBLANK ( [Título da proposta] ) || [Título da proposta] = "", "Sem título identificado", [Título da proposta] )
        VAR vMun    = IF ( ISBLANK ( [Município] ) || [Município] = "", "Não identificado", [Município] )
        VAR vMeso   = IF ( ISBLANK ( [Mesorregião] ) || [Mesorregião] = "", "Não identificado", [Mesorregião] )
        VAR vAno    = IF ( ISBLANK ( [Ano] ) || [Ano] = "" || [Ano] = "0", "Não identificado", "" & [Ano] )
        VAR vAPQ    = IF ( ISBLANK ( [APQ] ) || [APQ] = "", "Não se aplica", [APQ] )
        VAR vArea   = IF ( ISBLANK ( [Área de Conhecimento] ) || [Área de Conhecimento] = "", "Não identificado", [Área de Conhecimento] )
        VAR vCoord  = IF ( ISBLANK ( [Coordenador] ) || [Coordenador] = "", "Não identificado", [Coordenador] )
        VAR vExec   = IF ( ISBLANK ( [Executora] ) || [Executora] = "", "Não identificado", [Executora] )
        VAR vOrgao  = IF ( ISBLANK ( [Órgão estadual (Nome)] ) || [Órgão estadual (Nome)] = "", "N/A", [Órgão estadual (Nome)] )
        VAR vOrgaoHtml = IF ( vOrgao <> "N/A", "<div class='f'><b>Órgão Estadual</b><span data-k='orgao'>" & vOrgao & "</span></div>", "" )
        VAR vConc   = [Valor Concedente]
        VAR vApv    = [Valor Total Aprovado (com Contrapartida)]
        VAR rRaw    = [Resumo]
        VAR vResumo = IF ( ISBLANK ( rRaw ) || rRaw = "", "Não informado", IF ( rRaw = "NÃO SE APLICA", "Não se aplica", IF ( LEN ( rRaw ) > 100, LEFT ( rRaw, 97 ) & "...", rRaw ) ) )
        RETURN
            "<li class='card' data-dir='DIAE' data-proj='Cidades do Futuro + Hub Resgates' data-conc='" & FORMAT ( vConc, "0.00", "en-US" ) & "' data-apv='" & FORMAT ( vApv, "0.00", "en-US" ) & "'>" &
                "<div class='card-h'><span class='card-t' data-k='tit'>" & vTit & "</span>" & BtnCopiar & "</div>" &
                "<div class='grid'>" &
                    "<div class='f'><b>Município</b><span data-k='mun'>" & vMun & "</span></div>" &
                    "<div class='f'><b>Mesorregião</b><span data-k='meso'>" & vMeso & "</span></div>" &
                    "<div class='f'><b>Ano</b><span data-k='ano'>" & vAno & "</span></div>" &
                    "<div class='f'><b>Edital / APQ</b><span data-k='num'>" & vAPQ & "</span></div>" &
                    "<div class='f'><b>Área</b><span data-k='area'>" & vArea & "</span></div>" &
                    "<div class='f'><b>Coordenador(a)</b><span data-k='coord'>" & vCoord & "</span></div>" &
                    "<div class='f full'><b>Executora / Proponente</b><span data-k='exec'>" & vExec & "</span></div>" &
                    vOrgaoHtml &
                "</div>" &
                "<div class='val'>" &
                    "<span>Valor Concedente</span><b data-k='valor'>" & FORMAT ( vConc, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                    "<span>Total c/ Contrapartida</span><b data-k='aprov'>" & FORMAT ( vApv, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                "</div>" &
                "<div class='f full card-resumo'><b>Resumo</b><span data-k='resumo'>" & vResumo & "</span></div>" &
            "</li>",
        ""
    )

VAR DetalheHubMg =
    CONCATENATEX (
        FILTER (
            ProjetosCMunicipios,
            [Projeto] = "HUBMG GOV"
                && [ID_Projeto] IN ID_selecionados_AND
        ),
        VAR vTit    = IF ( ISBLANK ( [Título da proposta] ) || [Título da proposta] = "", "Sem título identificado", [Título da proposta] )
        VAR vMun    = IF ( ISBLANK ( [Município] ) || [Município] = "", "Não identificado", [Município] )
        VAR vMeso   = IF ( ISBLANK ( [Mesorregião] ) || [Mesorregião] = "", "Não identificado", [Mesorregião] )
        VAR vAno    = IF ( ISBLANK ( [Ano] ) || [Ano] = "" || [Ano] = "0", "Não identificado", "" & [Ano] )
        VAR vAPQ    = IF ( ISBLANK ( [APQ] ) || [APQ] = "", "Não se aplica", [APQ] )
        VAR vArea   = IF ( ISBLANK ( [Área de Conhecimento] ) || [Área de Conhecimento] = "", "Não identificado", [Área de Conhecimento] )
        VAR vCoord  = IF ( ISBLANK ( [Coordenador] ) || [Coordenador] = "", "Não identificado", [Coordenador] )
        VAR vExec   = IF ( ISBLANK ( [Executora] ) || [Executora] = "", "Não identificado", [Executora] )
        VAR vOrgao  = IF ( ISBLANK ( [Órgão estadual (Nome)] ) || [Órgão estadual (Nome)] = "", "N/A", [Órgão estadual (Nome)] )
        VAR vOrgaoHtml = IF ( vOrgao <> "N/A", "<div class='f'><b>Órgão Estadual</b><span data-k='orgao'>" & vOrgao & "</span></div>", "" )
        VAR vConc   = [Valor Concedente]
        VAR vApv    = [Valor Total Aprovado (com Contrapartida)]
        VAR rRaw    = [Resumo]
        VAR vResumo = IF ( ISBLANK ( rRaw ) || rRaw = "", "Não informado", IF ( rRaw = "NÃO SE APLICA", "Não se aplica", IF ( LEN ( rRaw ) > 100, LEFT ( rRaw, 97 ) & "...", rRaw ) ) )
        RETURN
            "<li class='card' data-dir='DIAE' data-proj='HubMG GOV' data-conc='" & FORMAT ( vConc, "0.00", "en-US" ) & "' data-apv='" & FORMAT ( vApv, "0.00", "en-US" ) & "'>" &
                "<div class='card-h'><span class='card-t' data-k='tit'>" & vTit & "</span>" & BtnCopiar & "</div>" &
                "<div class='grid'>" &
                    "<div class='f'><b>Município</b><span data-k='mun'>" & vMun & "</span></div>" &
                    "<div class='f'><b>Mesorregião</b><span data-k='meso'>" & vMeso & "</span></div>" &
                    "<div class='f'><b>Ano</b><span data-k='ano'>" & vAno & "</span></div>" &
                    "<div class='f'><b>Edital / APQ</b><span data-k='num'>" & vAPQ & "</span></div>" &
                    "<div class='f'><b>Área</b><span data-k='area'>" & vArea & "</span></div>" &
                    "<div class='f'><b>Coordenador(a)</b><span data-k='coord'>" & vCoord & "</span></div>" &
                    "<div class='f full'><b>Executora / Proponente</b><span data-k='exec'>" & vExec & "</span></div>" &
                    vOrgaoHtml &
                "</div>" &
                "<div class='val'>" &
                    "<span>Valor Concedente</span><b data-k='valor'>" & FORMAT ( vConc, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                    "<span>Total c/ Contrapartida</span><b data-k='aprov'>" & FORMAT ( vApv, "R$ #,##0.00", "pt-BR" ) & "</b>" &
                "</div>" &
                "<div class='f full card-resumo'><b>Resumo</b><span data-k='resumo'>" & vResumo & "</span></div>" &
            "</li>",
        ""
    )

VAR ValorConcedente = [ValorConcedenteTotal]
VAR ValorAprovado   = FORMAT ( CALCULATE ( SUM ( ProjetosCMunicipios[Valor Total Aprovado (com Contrapartida)] ), ProjetosCMunicipios[ID_Projeto] IN ID_selecionados_AND ), "R$ #,##0.00", "pt-BR" )
VAR quantidadeCDF   = [quantidadeCDF]
VAR QtdRenovacoes   = qCdf - quantidadeCDF

-- ===================== CATÁLOGO DE PROGRAMAS (AGRUPADO POR DIRETORIA) =====================
-- Colunas: Value1 ordem | Value2 nome | Value3 qtd | Value4 cor | Value5 fundo |
--          Value6 texto | Value7 marcador | Value8 cartões | Value9 extra chip | Value10 diretoria
VAR Programas =
    {
        -- DPD · Diretoria de Pesquisa e Desenvolvimento (Azul Institucional)
        (  1, "Ambientes Promotores",             qAmbientes,   "#2563eb", "#f8fafc", "#0f172a", "", IF ( qAmbientes > 0,   DetalheAmbientes ),   "", "DPD" ),
        (  2, "Cientista Empreendedor",           qCientista,   "#3b82f6", "#f8fafc", "#0f172a", "", IF ( qCientista > 0,   DetalheCientista ),   "", "DPD" ),
        (  3, "Laboratórios Certificadores",      qLab,         "#1d4ed8", "#f8fafc", "#0f172a", "", IF ( qLab > 0,         DetalheLab ),         "", "DPD" ),
        (  4, "Parques Tecnológicos",             qParques,     "#60a5fa", "#f8fafc", "#0f172a", "", IF ( qParques > 0,     DetalheParques ),     "", "DPD" ),
        (  5, "Tecpop",                           qTecpop,      "#1e40af", "#f8fafc", "#0f172a", "", IF ( qTecpop > 0,      DetalheTecpop ),      "", "DPD" ),

        -- DCTT · Diretoria de Ciência e Transferência de Tecnologia (Ciano / Petróleo)
        (  6, "Alysson Paolinelli",               qAlysson,     "#0891b2", "#f8fafc", "#0f172a", "", IF ( qAlysson > 0,     DetalheAlysson ),     "", "DCTT" ),
        (  7, "Compete Minas",                    qCompete,     "#0284c7", "#f8fafc", "#0f172a", "", IF ( qCompete > 0,     DetalheCompete ),     "", "DCTT" ),
        (  8, "Incremento da Maturidade",         qMaturidade,  "#0e7490", "#f8fafc", "#0f172a", "", IF ( qMaturidade > 0,  DetalheMaturidade ),  "", "DCTT" ),
        (  9, "PCTI",                             qPCTI,        "#06b6d4", "#f8fafc", "#0f172a", "", IF ( qPCTI > 0,        DetalhePCTI ),        "", "DCTT" ),
        ( 10, "Pesquisador na Empresa",           qPesqEmp,     "#0369a1", "#f8fafc", "#0f172a", "", IF ( qPesqEmp > 0,     DetalhePesqEmp ),     "", "DCTT" ),
        ( 11, "Pró-Inovação",                     qProInov,     "#22d3ee", "#f8fafc", "#0f172a", "", IF ( qProInov > 0,     DetalheProInov ),     "", "DCTT" ),
        ( 12, "Tríplice Hélice",                  qTriplice,    "#155e75", "#f8fafc", "#0f172a", "", IF ( qTriplice > 0,    DetalheTriplice ),    "", "DCTT" ),

        -- DIPRO · Diretoria de Inovação para o Setor Produtivo (Verde Esmeralda / Teal)
        ( 13, "Come To Minas",                    qComeToMinas, "#0d9488", "#f8fafc", "#0f172a", "", IF ( qComeToMinas > 0, DetalheComeToMinas ), "", "DIPRO" ),
        ( 14, "Compete Minas - Empresas",         qCompeteEmp,  "#059669", "#f8fafc", "#0f172a", "", IF ( qCompeteEmp > 0,  DetalheCompeteEmp ),  "", "DIPRO" ),
        ( 15, "Eventech",                         qEventech,    "#14b8a6", "#f8fafc", "#0f172a", "", IF ( qEventech > 0,    DetalheEventech ),    "", "DIPRO" ),
        ( 16, "Seed",                             qSEED,        "#10b981", "#f8fafc", "#0f172a", "", IF ( qSEED > 0,        DetalheSeed ),        "", "DIPRO" ),

        -- DIAE · Diretoria de Inovação Aberta e Empreendedorismo Tecnológico (Índigo)
        ( 17, "Cidades do Futuro",                qCdf,         "#4f46e5", "#f8fafc", "#0f172a", "", IF ( qCdf > 0,         DetalheCdfACT ),
                "<small>&nbsp;·&nbsp;" & quantidadeCDF & " mun. (" & QtdRenovacoes & " renov.)</small>", "DIAE" ),
        ( 18, "Cidades do Futuro + Hub Resgates", qCdfResgate,  "#6366f1", "#f8fafc", "#0f172a", "", IF ( qCdfResgate > 0,  DetalheCdfResgates ), "", "DIAE" ),
        ( 19, "HubMG GOV",                        qHubMg,       "#818cf8", "#f8fafc", "#0f172a", "", IF ( qHubMg > 0,       DetalheHubMg ),       "", "DIAE" )
    }

VAR ProgramasAtivos = FILTER ( Programas, [Value3] > 0 )
VAR QtdProgramas    = COUNTROWS ( ProgramasAtivos ) + 0
VAR QtdMunicipios   = COUNTROWS ( MunicipiosLimpos ) + 0
VAR QtdTotal        = QuantidadeTotal + 0

VAR Chips =
    CONCATENATEX (
        ProgramasAtivos,
        "<button class='chip' type='button' data-go='s" & [Value1] & "' data-dir='" & [Value10] & "'" &
        " title='" & [Value10] & " · " & LOOKUPVALUE ( TabelaNumeros[Extenso], TabelaNumeros[Numero], [Value3] ) & "'" &
        " style='--c:" & [Value4] & "'>" &
        "<span class='chip-n'>" & [Value3] & "</span><span class='chip-l'>" & [Value2] & [Value9] & "</span></button>",
        "", [Value1], ASC
    )

VAR Secoes =
    CONCATENATEX (
        ProgramasAtivos,
        "<details class='sec' id='s" & [Value1] & "' data-dir='" & [Value10] & "' open style='--c:" & [Value4] & "'>" &
            "<summary class='sh'>" &
                "<span class='dir-b' data-d='" & [Value10] & "'>" & [Value10] & "</span>" &
                "<span class='sec-t'>" & [Value2] & "</span>" &
                "<span class='sec-val'></span>" &
                "<span class='sec-n' data-total='" & [Value3] & "'>" & [Value3] & "</span>" &
                "<span class='chev'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><polyline points='6 9 12 15 18 9'/></svg></span>" &
            "</summary>" &
            "<ul class='cards'>" & [Value8] & "</ul>" &
            IF ( [Value3] > 6, "<div class='sec-ft'><button type='button' class='vm-btn'><span>Ver todos os <b>" & [Value3] & "</b> projetos</span> <svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><polyline points='6 9 12 15 18 9'/></svg></button></div>", "" ) &
        "</details>",
        "", [Value1], ASC
    )

VAR DadosJS =
    "[" &
    CONCATENATEX (
        ProgramasAtivos,
        "{n:'" & [Value2] & "',q:" & [Value3] & ",c:'" & [Value4] & "',s:'s" & [Value1] & "',d:'" & [Value10] & "'}",
        ",", [Value1], ASC
    ) &
    "]"

VAR BotoesDiretoria =
    "<button type='button' class='dir on' data-dir=''>Todas <b>" & FORMAT ( QtdTotal, "#,##0", "pt-BR" ) & "</b></button>" &
    IF ( qDPD > 0,   "<button type='button' class='dir' data-dir='DPD' style='--dc:#2563eb' title='Diretoria de Pesquisa e Desenvolvimento'><i class='dot'></i>DPD <b>" & FORMAT ( qDPD, "#,##0", "pt-BR" ) & "</b></button>", "" ) &
    IF ( qDCTT > 0,  "<button type='button' class='dir' data-dir='DCTT' style='--dc:#0891b2' title='Diretoria de Ciência e Transferência de Tecnologia'><i class='dot'></i>DCTT <b>" & FORMAT ( qDCTT, "#,##0", "pt-BR" ) & "</b></button>", "" ) &
    IF ( qDIPRO > 0, "<button type='button' class='dir' data-dir='DIPRO' style='--dc:#0d9488' title='Diretoria de Inovação para o Setor Produtivo'><i class='dot'></i>DIPRO <b>" & FORMAT ( qDIPRO, "#,##0", "pt-BR" ) & "</b></button>", "" ) &
    IF ( qDIAE > 0,  "<button type='button' class='dir' data-dir='DIAE' style='--dc:#4f46e5' title='Diretoria de Inovação Aberta e Empreendedorismo Tecnológico'><i class='dot'></i>DIAE <b>" & FORMAT ( qDIAE, "#,##0", "pt-BR" ) & "</b></button>", "" )

VAR TermosBox =
    IF (
        BuscaAtiva,
        "<div class='box termos'><div class='sh'>Termos pesquisados <small>(todos presentes)</small></div><div class='chips'>" &
        CONCATENATEX ( TermosPesquisados, "<span class='kw'>" & 'BuscaIndice'[Keyword] & "</span>", "", 'BuscaIndice'[Keyword], ASC ) &
        "</div></div>",
        ""
    )

-- ===================== ESTILO (CSS CLEAN INSTITUCIONAL + PAINEL INTEGRADO 3D) =====================

-- ===================== ESTILO (CSS CLEAN INSTITUCIONAL + PAINEL INTEGRADO 3D) =====================
VAR CSS = "
#rp{--ink:#0f172a;--mut:#64748b;--line:#e2e8f0;--bg:#f1f5f9;font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);background:var(--bg);padding:8px 10px;box-sizing:border-box;min-height:100%;font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
#rp *{box-sizing:border-box}
#rp .hero{position:relative;display:flex;min-height:212px;border-radius:10px;overflow:hidden;color:#f8fafc;background:linear-gradient(135deg,#091929 0%,#0f2740 55%,#0a1d30 100%);border:1px solid #1e3a52;box-shadow:0 4px 14px rgba(15,23,42,.18);transition:min-height .22s ease}
#rp.fs-3d .hero{position:fixed;inset:8px;z-index:9999;min-height:0;height:calc(100vh - 16px);border-radius:12px;box-shadow:0 20px 50px rgba(2,6,23,.75);border:1px solid #334155}
#rp.fs-3d .bar,#rp.fs-3d .dash,#rp.fs-3d .area,#rp.fs-3d .topo{display:none!important}
#rp .hero-info{flex:0 0 336px;padding:10px 14px;display:flex;flex-direction:column;gap:5px;padding:12px 14px;display:flex;flex-direction:column;gap:6px;z-index:2;background:linear-gradient(90deg,rgba(9,25,41,.96) 80%,rgba(9,25,41,0));border-right:1px solid rgba(255,255,255,.07)}
#rp.fs-3d .hero-info{flex:0 0 348px;background:rgba(9,25,41,.94);backdrop-filter:blur(8px)}
#rp .eyebrow{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:9.5px;letter-spacing:.8px;text-transform:uppercase;color:#94a3b8;font-weight:600}
#rp .fbadge{display:none;background:rgba(255,255,255,.12);color:#f8fafc;border:1px solid rgba(255,255,255,.22);border-radius:5px;padding:2px 7px;font-size:9.5px;font-weight:600;cursor:pointer;letter-spacing:.2px;font-family:inherit;transition:background .15s}
#rp .fbadge:hover{background:rgba(255,255,255,.2)}
#rp.tem-filtro .fbadge{display:inline-flex;align-items:center;gap:4px}
#rp .geo-strip{display:grid;grid-template-columns:1fr 1fr;gap:5px;background:rgba(15,23,42,.55);border:1px solid rgba(148,163,184,.16);border-radius:6px;padding:5px 8px}
#rp .geo-kpi{display:flex;flex-direction:column;gap:1px;min-width:0}
#rp .geo-kpi span{font-size:9px;text-transform:uppercase;letter-spacing:.5px;color:#94a3b8;font-weight:600}
#rp .geo-kpi b{font-size:12.5px;color:#f8fafc;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#rp .hero-kpis{display:grid;grid-template-columns:1fr 1fr;gap:5px}
#rp .hk{background:rgba(15,23,42,.65);border:1px solid rgba(148,163,184,.18);border-radius:6px;padding:5px 8px;display:flex;flex-direction:column;gap:2px}
#rp .hk.val{grid-column:1 / -1;background:linear-gradient(135deg,rgba(15,23,42,.85),rgba(2,132,199,.15));border-color:rgba(56,189,248,.32);padding:5px 9px}
#rp .hk.val.aprov{grid-column:1 / -1;background:linear-gradient(135deg,rgba(15,23,42,.85),rgba(13,148,136,.15));border-color:rgba(45,212,191,.32);padding:5px 9px}
#rp .hk span{font-size:9.5px;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;font-weight:600}
#rp .hk b{font-size:16px;color:#f8fafc;font-weight:800;line-height:1.1}
#rp .hk.val b{font-size:15.5px;color:#38bdf8}
#rp .hk.val.aprov b{font-size:15.5px;color:#2dd4bf}
#rp .hk small{font-size:9px;color:#64748b;font-weight:500}
#rp .fs-dirs{display:flex;flex-direction:column;gap:3px;margin-top:2px}
#rp .fs-dirs-lbl{font-size:9px;text-transform:uppercase;letter-spacing:.6px;color:#94a3b8;font-weight:700}
#rp .fs-dirs-row{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
#rp .fs-dir{display:inline-flex;align-items:center;justify-content:center;gap:4px;padding:4px 3px;border-radius:5px;font-size:10px;font-weight:700;background:rgba(255,255,255,.06);color:#cbd5e1;border:1px solid rgba(255,255,255,.14);cursor:pointer;font-family:inherit;transition:all .15s}
#rp .fs-dir:hover{background:rgba(255,255,255,.14);color:#fff}
#rp .fs-dir.on{background:#0284c7;color:#fff;border-color:#38bdf8;box-shadow:0 0 10px rgba(2,132,199,.55)}
#rp .fs-dir i{width:6px;height:6px;border-radius:50%;display:inline-block}
#rp .hint{margin-top:auto;font-size:9px;color:#64748b;line-height:1.25}
#rp .viz{flex:1;position:relative;min-height:212px;overflow:hidden}
#rp.fs-3d .viz{min-height:0;height:100%}
#rp #rp-3d{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;touch-action:none}
#rp .viz-top{position:absolute;left:10px;right:10px;top:8px;display:flex;align-items:center;justify-content:space-between;gap:8px;z-index:5;pointer-events:none}
#rp .vmodes{display:inline-flex;background:rgba(15,23,42,.88);border:1px solid rgba(148,163,184,.28);border-radius:6px;padding:2px;pointer-events:auto;backdrop-filter:blur(6px);box-shadow:0 2px 8px rgba(0,0,0,.25)}
#rp .vm{border:none;background:transparent;color:#94a3b8;padding:4px 9px;font-size:10px;font-weight:700;border-radius:4px;cursor:pointer;font-family:inherit;letter-spacing:.2px;transition:all .14s}
#rp .vm:hover{color:#fff}
#rp .vm.on{background:#0284c7;color:#fff;box-shadow:0 1px 6px rgba(2,132,199,.45)}
#rp .leg3d{display:inline-flex;align-items:center;gap:9px;background:rgba(15,23,42,.82);border:1px solid rgba(148,163,184,.22);border-radius:6px;padding:3px 9px;font-size:9.5px;color:#cbd5e1;pointer-events:auto;backdrop-filter:blur(6px)}
#rp .leg3d span{display:inline-flex;align-items:center;gap:4px;font-weight:600}
#rp .leg3d i{width:7px;height:7px;border-radius:2px;display:inline-block}
#rp .vtools{position:absolute;right:10px;bottom:8px;display:flex;align-items:center;gap:4px;z-index:5}
#rp .vt{display:inline-flex;align-items:center;justify-content:center;gap:5px;background:rgba(15,23,42,.88);border:1px solid rgba(148,163,184,.28);color:#e2e8f0;border-radius:5px;padding:4px 9px;font-size:10px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .14s;backdrop-filter:blur(6px);white-space:nowrap;line-height:1}
#rp .vt:hover{background:#0284c7;color:#fff;border-color:#38bdf8}
#rp .vt svg{flex-shrink:0;display:block}
#rp .vt:hover{background:#0284c7;color:#fff;border-color:#38bdf8}
#rp .tip{position:absolute;z-index:10;pointer-events:none;background:rgba(9,25,41,.96);border:1px solid #38bdf8;box-shadow:0 8px 24px rgba(2,6,23,.55);border-radius:7px;padding:6px 10px;font-size:11px;color:#f8fafc;transform:translate(-50%,-125%);opacity:0;transition:opacity .12s,transform .12s;white-space:nowrap;backdrop-filter:blur(8px)}
#rp .tip.on{opacity:1;transform:translate(-50%,-138%)}
#rp .tip b{display:block;font-size:12px;color:#38bdf8;font-weight:700}
#rp .tip em{display:inline-block;margin-left:6px;font-style:normal;font-size:9.5px;color:#94a3b8;font-weight:600}
#rp .tip .tv{display:block;margin-top:2px;font-size:10.5px;color:#e2e8f0;font-weight:600}
#rp .tip small{display:block;margin-top:3px;font-size:9.5px;color:#94a3b8}
#rp .hero.sem3d .bars2d{display:flex}
#rp .bars2d{display:none;position:absolute;inset:40px 10px 10px;flex-direction:column;gap:3px;overflow-y:auto;padding-right:4px}
#rp .b2{display:grid;grid-template-columns:140px 1fr 34px;align-items:center;gap:8px;font-size:10px;color:#cbd5e1;cursor:pointer;padding:2px 4px;border-radius:4px;transition:background .12s}
#rp .b2:hover{background:rgba(255,255,255,.08);color:#fff}
#rp .b2 span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#rp .b2 em{height:7px;background:rgba(255,255,255,.1);border-radius:3px;overflow:hidden;display:block}
#rp .b2 i{height:100%;border-radius:3px;display:block}
#rp .b2 b{text-align:right;font-size:10.5px;color:#f8fafc}

#rp .bar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:8px 0;background:#fff;border:1px solid var(--line);border-radius:8px;padding:5px 8px;box-shadow:0 1px 3px rgba(15,23,42,.05)}
#rp .bar-l{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
#rp .dir-group{display:flex;gap:3px;align-items:center}
#rp .dir{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;font-size:10.5px;font-weight:600;border:1px solid var(--line);background:#fff;border-radius:5px;cursor:pointer;color:var(--ink);font-family:inherit;transition:all .12s}
#rp .dir:hover{background:#f8fafc;border-color:#cbd5e1}
#rp .dir.on{background:var(--dc,#0f172a);color:#fff;border-color:transparent;box-shadow:0 1px 4px rgba(15,23,42,.2)}
#rp .dir i.dot{width:6px;height:6px;border-radius:50%;background:var(--dc,#64748b);display:inline-block}
#rp .dir.on i.dot{background:#fff}
#rp .dir b{font-weight:700;opacity:.9}
#rp .sep{width:1px;height:18px;background:var(--line);margin:0 2px}
#rp .ord{padding:4px 7px;font-size:10.5px;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink);cursor:pointer;font-family:inherit}
#rp .bar-r{display:flex;align-items:center;gap:4px}
#rp .btn{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;font-size:10.5px;font-weight:600;border:1px solid var(--line);background:#fff;border-radius:5px;cursor:pointer;color:var(--ink);font-family:inherit;transition:all .12s}
#rp .btn:hover{background:#f8fafc;border-color:#cbd5e1}
#rp .btn.prim{background:#0284c7;color:#fff;border-color:transparent}
#rp .btn.prim:hover{background:#0369a1}
#rp .btn.graf{background:#f0f9ff;color:#0284c7;border-color:#bae6fd}
#rp .btn.graf:hover{background:#e0f2fe;border-color:#7dd3fc}
#rp .btn.graf.on{background:#0284c7;color:#fff;border-color:#0284c7}

#rp .subbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 2px 4px;font-size:11px}
#rp .busca-wrap{position:relative;flex:1;max-width:320px}
#rp .busca-i{position:absolute;left:7px;top:50%;transform:translateY(-50%);color:#94a3b8;pointer-events:none}
#rp .q{width:100%;padding:4px 22px 4px 24px;border:1px solid var(--line);border-radius:5px;font-size:11px;outline:none;background:#fff;font-family:inherit}
#rp .q:focus{border-color:#0284c7;box-shadow:0 0 0 2px rgba(2,132,199,.15)}
#rp .q-x{position:absolute;right:4px;top:50%;transform:translateY(-50%);border:none;background:transparent;cursor:pointer;color:#94a3b8;font-size:12px;padding:2px 4px;line-height:1;display:none}
#rp.filtrando-txt .q-x{display:block}
#rp .filter-tags{display:inline-flex;align-items:center;gap:5px;flex-wrap:wrap}
#rp .ftag{display:inline-flex;align-items:center;gap:4px;background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;border-radius:4px;padding:2px 7px;font-size:10px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .12s}
#rp .ftag:hover{background:#bae6fd}
#rp .cnt{font-size:11px;color:var(--mut);font-weight:600}

#rp .gmodal{display:none;background:#fff;border:1px solid #bae6fd;border-radius:9px;padding:12px 14px;margin-bottom:10px;box-shadow:0 8px 24px rgba(2,132,199,.14)}
#rp .gmodal.on{display:block}
#rp .gm-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;margin-bottom:8px}
#rp .gm-title{font-size:12px;font-weight:700;color:#0f172a;display:inline-flex;align-items:center;gap:6px}
#rp .gm-title small{font-weight:500;color:#64748b;font-size:10.5px}
#rp .gm-close{border:none;background:transparent;color:#64748b;cursor:pointer;font-size:11px;font-weight:600;padding:3px 6px;border-radius:4px;font-family:inherit}
#rp .gm-close:hover{background:#f1f5f9;color:#0f172a}
#rp .gm-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px}
#rp .gm-kpi{background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:5px 8px;display:flex;flex-direction:column;gap:1px}
#rp .gm-kpi span{font-size:9px;text-transform:uppercase;color:#64748b;font-weight:600;letter-spacing:.4px}
#rp .gm-kpi b{font-size:12px;color:#0f172a;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#rp .gm-body{display:block;width:100%}
#rp .gm-chart{max-height:360px;overflow-y:auto;display:flex;flex-direction:column;gap:5px}
#rp .gm-bar-row{display:grid;grid-template-columns:195px 1fr 48px 145px;align-items:center;gap:12px;font-size:11px;cursor:pointer;padding:4px 8px;border-radius:5px;transition:background .12s,border .12s;border:1px solid transparent}
#rp .gm-bar-row:hover{background:#f1f5f9}
#rp .gm-bar-row.on{background:#e0f2fe;border:1px solid #0284c7;box-shadow:0 0 8px rgba(2,132,199,.25)}
#rp .gm-bar-row.on span{color:#0369a1;font-weight:700}
#rp .gm-bar-row span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#1e293b;font-weight:600}
#rp .gm-bar-track{height:12px;background:#f1f5f9;border-radius:6px;overflow:hidden;position:relative}
#rp .gm-bar-fill{height:100%;background:linear-gradient(90deg,#0284c7,#38bdf8);border-radius:6px;transition:width .25s ease}
#rp .gm-bar-q{font-weight:700;color:#0f172a;text-align:right}
#rp .gm-bar-v{font-size:10.5px;color:#64748b;text-align:right;white-space:nowrap}

#rp .dash{margin-bottom:8px}
#rp .dir-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
#rp .dcard{background:#fff;border:1px solid var(--line);border-radius:7px;padding:7px 9px;display:flex;flex-direction:column;gap:5px;box-shadow:0 1px 3px rgba(15,23,42,.04);border-top:3px solid var(--dc,#0f172a);transition:opacity .15s}
#rp .dcard.off{opacity:.35}
#rp .dcard-h{display:flex;align-items:center;justify-content:space-between;cursor:pointer}
#rp .dcard-t{font-size:11px;font-weight:800;color:var(--dc,#0f172a);letter-spacing:.3px}
#rp .dcard-q{font-size:10px;font-weight:700;color:#64748b}
#rp .dcard-v{font-size:11px;font-weight:700;color:#0f172a;line-height:1}
#rp .dcard-m{display:flex;flex-direction:column;gap:2px;max-height:125px;overflow-y:auto;padding-right:2px}
#rp .drow{display:grid;grid-template-columns:1fr 28px;align-items:center;gap:4px;font-size:10px;color:#334155;padding:2px 4px;border-radius:3px;cursor:pointer;border:none;background:transparent;text-align:left;font-family:inherit;width:100%}
#rp .drow:hover{background:#f1f5f9}
#rp .drow.zero{opacity:.45}
#rp .drow span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#rp .drow b{text-align:right;font-weight:700;color:#0f172a}
#rp .obs-bar{margin-top:6px;background:#f8fafc;border:1px solid #e2e8f0;border-left:3px solid #0284c7;border-radius:5px;padding:6px 9px;font-size:10px;color:#475569;line-height:1.4}
#rp .obs-bar b{color:#0f172a}

#rp .area{display:flex;flex-direction:column;gap:8px}
#rp .box{background:#fff;border:1px solid var(--line);border-radius:8px;padding:8px 10px;box-shadow:0 1px 3px rgba(15,23,42,.04)}
#rp .sh{font-size:11px;font-weight:500;color:var(--ink);display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;flex-wrap:nowrap;white-space:nowrap;padding:7px 11px}
#rp .dir-b{display:inline-flex;align-items:center;justify-content:center;padding:1.5px 6px;border-radius:4px;font-size:9.5px;font-weight:700;letter-spacing:.3px;color:#fff;line-height:1.2;flex-shrink:0}
#rp .dir-b[data-d='DPD']{background:#2563eb}
#rp .dir-b[data-d='DCTT']{background:#0891b2}
#rp .dir-b[data-d='DIPRO']{background:#0d9488}
#rp .dir-b[data-d='DIAE']{background:#4f46e5}
#rp .sh small{font-size:10px;font-weight:400;color:var(--mut)}
#rp .sh .pill{background:#e2e8f0;color:var(--ink);border-radius:10px;padding:1px 6px;font-size:9.5px;font-weight:700}
#rp .sh .chev{margin-left:auto;color:var(--mut);transition:transform .15s}
#rp details[open] .sh .chev{transform:rotate(180deg)}
#rp .mun-tools{padding:6px 0 4px}
#rp .mun-q{width:100%;max-width:240px;padding:3px 7px;font-size:10px;border:1px solid var(--line);border-radius:4px;outline:none;font-family:inherit}
#rp .mun-q:focus{border-color:#0284c7}
#rp .mun-list{display:flex;flex-wrap:wrap;gap:3px;margin-top:6px;max-height:120px;overflow-y:auto}
#rp .mun{border:1px solid var(--line);background:#fff;border-radius:4px;padding:2px 6px;font-size:10px;color:var(--ink);cursor:pointer;font-family:inherit;transition:all .12s}
#rp .mun:hover{background:#f1f5f9;border-color:#cbd5e1}
#rp .mun.on{background:#0284c7;color:#fff;border-color:transparent;font-weight:700}
#rp .mun.escondido{display:none}

#rp .chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
#rp .chip{display:inline-flex;align-items:center;gap:4px;padding:3px 7px;border-radius:4px;font-size:10px;font-weight:600;border:1px solid;cursor:pointer;background:#fff;font-family:inherit;transition:opacity .12s}
#rp .chip.fora{opacity:.35}
#rp .chip b{font-weight:700}
#rp .resumo{padding:7px 10px}
#rp .resumo p{margin:0 0 5px;font-size:10.5px;color:var(--mut)}

#rp .sec{border:1px solid var(--line);background:#fff;border-radius:8px;padding:0;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,.04);transition:opacity .15s}
#rp .sec.vazio{display:none}
#rp .sec-h{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:#fafafa;border-bottom:1px solid var(--line);cursor:pointer;user-select:none;gap:8px}
#rp .sec-t{font-size:12px;font-weight:500;color:#0f172a;display:inline-flex;align-items:center;gap:6px;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#rp .sec-val{font-size:11px;font-weight:600;color:#0284c7;margin-left:auto;flex-shrink:0;white-space:nowrap}
#rp .sec-n{background:#f1f5f9;border:1px solid #cbd5e1;color:#334155;border-radius:6px;padding:1.5px 7px;font-size:10px;font-weight:700;flex-shrink:0;white-space:nowrap;display:inline-flex;align-items:center}
#rp .sh .chev{flex-shrink:0}
#rp .sec-soval .sec-val{display:none}
#rp .sec-chev{color:var(--mut);transition:transform .15s}
#rp .sec[open] .sec-chev{transform:rotate(180deg)}
#rp .cards{list-style:none;margin:0;padding:8px 10px;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:6px}
#rp .card{border:1px solid var(--line);border-radius:6px;padding:7px 9px;display:flex;flex-direction:column;gap:5px;background:#fff;font-size:11px;position:relative}
#rp .card.oculto{display:none}
#rp .card-h{display:flex;align-items:flex-start;justify-content:space-between;gap:6px}
#rp .card-t{font-weight:400;color:var(--ink);line-height:1.25;font-size:11px;flex:1}
#rp .cp{border:none;background:transparent;cursor:pointer;color:var(--mut);padding:2px;border-radius:3px;line-height:1}
#rp .cp:hover{background:#f1f5f9;color:var(--ink)}
#rp .grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 6px}
#rp .f{display:flex;flex-direction:column}
#rp .f.full{grid-column:1 / -1}
#rp .k{font-size:9px;text-transform:uppercase;color:var(--mut);letter-spacing:.3px}
#rp .v{font-weight:600;color:var(--ink);word-break:break-word}
#rp .val{display:flex;align-items:center;justify-content:space-between;padding-top:4px;border-top:1px dashed var(--line);margin-top:2px;font-size:10.5px}
#rp .val b{color:#0284c7;font-weight:700}
#rp .sec-ft{padding:6px 10px;border-top:1px solid var(--line);background:#fafafa;display:flex;justify-content:center}
#rp .vm-btn{border:1px solid var(--line);background:#fff;border-radius:4px;padding:3px 10px;font-size:10px;font-weight:600;color:var(--mut);cursor:pointer;font-family:inherit}
#rp .vm-btn:hover{background:#f1f5f9;color:var(--ink)}
#rp .sec:not(.expand) .card:nth-child(n+7){display:none}
#rp .sec.expand .vm-btn{color:#0284c7}

#rp .empty{padding:24px;text-align:center;color:var(--mut);font-size:12px;background:#fff;border:1px dashed var(--line);border-radius:8px}
#rp .total{background:#fff;border:1px solid var(--line);border-radius:8px;padding:8px 12px;display:flex;justify-content:space-between;align-items:center;font-size:11.5px;font-weight:700;color:var(--ink)}
#rp .total b{color:#0284c7}
#rp .topo{position:fixed;right:16px;bottom:16px;width:32px;height:32px;border-radius:50%;background:#0284c7;color:#fff;border:none;box-shadow:0 3px 10px rgba(2,132,199,.35);cursor:pointer;display:none;align-items:center;justify-content:center;font-size:14px;z-index:90}
#rp .topo.on{display:flex}
#rp .toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%) translateY(10px);background:rgba(15,23,42,.92);color:#fff;padding:6px 14px;border-radius:6px;font-size:11px;font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,.2);opacity:0;pointer-events:none;transition:all .18s;z-index:9999}
#rp .toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.rp-clip{position:fixed;left:-99999px;top:0;width:900px}"

-- ===================== SCRIPT (INTERATIVIDADE + MAPA 3D + EXPORTAÇÃO WORD) =====================
VAR JS = "
(function(){
var root=document.getElementById('rp');if(!root)return;
function q(s,e){return (e||root).querySelector(s);}
function qa(s,e){return Array.prototype.slice.call((e||root).querySelectorAll(s));}
function norm(s){return (s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();}
function fmtBRL(v){return (v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
function scroller(){
  var p=root.parentElement;
  while(p&&p!==document.body){
    var ov=window.getComputedStyle(p).overflowY;
    if(ov==='auto'||ov==='scroll')return p;
    p=p.parentElement;
  }
  return window;
}
function rolarPara(el,offset){
  var sc=scroller(),off=(offset===undefined)?10:offset;
  if(!el)return;
  if(sc===window){
    var y=el.getBoundingClientRect().top+window.pageYOffset-off;
    if(window.scrollTo)window.scrollTo({top:Math.max(0,y),behavior:'smooth'});else window.scrollTop=Math.max(0,y);
  }else{
    var rEl=el.getBoundingClientRect(),rSc=sc.getBoundingClientRect();
    var top=sc.scrollTop+(rEl.top-rSc.top)-off;
    if(sc.scrollTo)sc.scrollTo({top:Math.max(0,top),behavior:'smooth'});else sc.scrollTop=Math.max(0,top);
  }
}
var toastEl=q('.toast'),toastTimer=0;
function toast(msg){
  if(!toastEl)return;
  toastEl.textContent=msg;toastEl.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(function(){toastEl.classList.remove('on');},2600);
}

