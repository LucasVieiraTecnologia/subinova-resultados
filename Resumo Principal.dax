/* ---------------- ESTADO GLOBAL E ELEMENTOS ---------------- */
var realce=null,dirsAtivas={},munAtivo='',munLabel='',mesoAtiva=-1,modo3D='mun',atualizarCena3D=null;
function qtdDirs(){return Object.keys(dirsAtivas).length;}
function dirOk(d){return qtdDirs()===0||Boolean(dirsAtivas[d]);}
function dirAtivaSingle(){var k=Object.keys(dirsAtivas);return k.length===1?k[0]:null;}

var inp=q('#rp-q'),cnt=q('#rp-cnt'),semRes=q('#rp-empty'),resumoTxt=q('#rp-rtxt'),totBar=q('#rp-tot'),ordSel=q('#rp-ord');
var kProj=q('#rp-kp'),kProg=q('#rp-kg'),kMun=q('#rp-km'),kVal=q('#rp-kv'),kValLbl=q('#rp-kvl'),kSub=q('#rp-ks'),kApv=q('#rp-kav');
var gMun=q('#rp-gmun'),gMeso=q('#rp-gmeso'),munTag=q('#rp-muntag'),mesoTag=q('#rp-mesotag');
var muns=qa('.mun'),dirs=qa('.dir'),fsDirs=qa('.fs-dir'),chips=qa('.chip'),secs=qa('.sec'),cards=qa('.card');


secs.forEach(function(s){atualizarPaginacaoSec(s,false);});
var baseTotal=parseInt(root.getAttribute('data-total'),10)||cards.length;
var baseProg=parseInt(root.getAttribute('data-progs'),10)||secs.length;
var baseMun=parseInt(root.getAttribute('data-muns'),10)||muns.length;
var baseValTxt=root.getAttribute('data-valor')||'R$ 0,00';
var baseApvTxt=root.getAttribute('data-aprov')||'R$ 0,00';

var munLabelMap={};
muns.forEach(function(m){var r=m.getAttribute('data-mun')||'';munLabelMap[norm(r)]=r;});

cards.forEach(function(li,idx){
  var eMun=li.querySelector('[data-k=mun]'),eTit=li.querySelector('[data-k=tit]'),eVal=li.querySelector('[data-k=valor]');
  li._mun=eMun?norm(eMun.textContent):'';
  li._munRaw=eMun?eMun.textContent.trim():'';
  if(li._mun&&!munLabelMap[li._mun])munLabelMap[li._mun]=li._munRaw;
  var kAlias=ALIAS_MUN[li._mun]||li._mun,infoM=MG_MUNS[kAlias];
  li._mi=(infoM!==undefined)?infoM[2]:-1;
  li._tit=eTit?norm(eTit.textContent):'';
  li._t=norm(li.textContent);
  var rawConc=li.getAttribute('data-conc');
  if(rawConc!==null){li._vc=parseFloat(rawConc)||0;}
  else if(eVal){var mv=(eVal.textContent||'').replace(/[^0-9,-]/g,'').replace(',','.');li._vc=parseFloat(mv)||0;}
  else{li._vc=0;}
  li._v=li._vc;
  var rawApv=li.getAttribute('data-apv');
  li._va=(rawApv!==null)?(parseFloat(rawApv)||0):0;
  li._d=li.getAttribute('data-dir')||'';
  li._proj=li.getAttribute('data-proj')||'';
  li._i=idx;
});

var somaPorSec={};
cards.forEach(function(li){
  var sec=li.closest('.sec');
  if(sec){somaPorSec[sec.id]=(somaPorSec[sec.id]||0)+li._v;}
});
(window.RP_DATA||[]).forEach(function(d){d.v=somaPorSec[d.s]||0;});

/* ---------- Painel de Matrizes das 4 Diretorias ---------- */
var dirMeta=[
  {d:'DPD',n:'Pesquisa e Desenvolvimento',cor:'#2563eb'},
  {d:'DCTT',n:'Ciência e Transferência de Tecnologia',cor:'#0891b2'},
  {d:'DIPRO',n:'Inovação para o Setor Produtivo',cor:'#0d9488'},
  {d:'DIAE',n:'Inovação Aberta e Empreendedorismo',cor:'#4f46e5'}
];

function renderizarMatrizesDiretoria(contagemPorSec){
  var box=q('#rp-dirgrid');if(!box)return;
  var progs=window.RP_DATA||[];
  box.innerHTML=dirMeta.map(function(dm){
    var lista=progs.filter(function(p){return p.d===dm.d;});
    var totD=0,valD=0;
    var rows=lista.map(function(p){
      var qv=(contagemPorSec&&contagemPorSec[p.s]!==undefined)?contagemPorSec[p.s]:p.q;
      totD+=qv;
      valD+=(p.v||0);
      return '<button type=button class=\'drow'+(qv===0?' zero':'')+'\' data-go=\''+p.s+'\' title=\''+p.n+': '+qv+' projetos\'><span>'+p.n+'</span><b>'+qv+'</b></button>';
    }).join('');
    var on=dirOk(dm.d)?'':' off';
    return '<div class=\'dcard'+on+'\' style=\'--dc:'+dm.cor+'\'><div class=dcard-h data-dir=\''+dm.d+'\' title=\'Filtrar diretoria '+dm.d+'\'><span class=dcard-t>'+dm.d+'</span><span class=dcard-q>'+totD+' proj.</span></div><div class=dcard-v>'+(valD>0?fmtBRL(valD):'—')+'</div><div class=dcard-m>'+rows+'</div></div>';
  }).join('');
}

/* ---------- Painel Analítico por Município (Abrir Gráfico) ---------- */
function atualizarGraficoMunicipios(){
  var gm=q('#rp-gmodal');if(!gm||!gm.classList.contains('on'))return;
  var agg={},totVis=0;
  cards.forEach(function(li){
    if(li.classList.contains('oculto'))return;
    totVis++;
    var m=li._mun||'nao identificado';
    var raw=munLabelMap[m]||li._munRaw||'Não identificado';
    if(!agg[m])agg[m]={m:m,raw:raw,q:0,v:0};
    agg[m].q++;agg[m].v+=li._v;
  });
  var arr=Object.keys(agg).map(function(k){return agg[k];}).sort(function(a,b){return (b.q-a.q)||(b.v-a.v);});
  var arrId=arr.filter(function(x){return x.m!=='nao identificado'&&x.m!=='municipio nao identificado';});
  var arrVal=(arrId.length?arrId:arr).slice().sort(function(a,b){return b.v-a.v;});
  var topQ=(arrId[0]||arr[0])||{raw:'—',q:0},topV=arrVal[0]||{raw:'—',v:0};
  var k1=q('#gm-k1'),k2=q('#gm-k2'),k3=q('#gm-k3'),k4=q('#gm-k4');
  if(k1)k1.textContent=totVis.toLocaleString('pt-BR')+' projetos';
  if(k2)k2.textContent=(arrId.length||arr.length).toLocaleString('pt-BR')+' municípios';
  if(k3)k3.textContent=topQ.raw+' ('+topQ.q+')';
  if(k4)k4.textContent=topV.raw+' · '+fmtBRL(topV.v);

  var ch=q('#gm-chart'),maxQ=arr.length?arr[0].q:1;
  if(ch){
    ch.innerHTML=arr.slice(0,35).map(function(x){
      var pct=Math.max(2,Math.round(100*x.q/maxQ));
      var isSel=Boolean(munAtivo&&norm(x.raw)===munAtivo);
      return '<div class=\'gm-bar-row'+(isSel?' on':'')+'\' data-mun=\''+x.raw.replace(/'/g,'')+'\' title=\'Clique para filtrar '+x.raw+'\'>'+
        '<span>'+x.raw+'</span>'+
        '<div class=gm-bar-track><div class=gm-bar-fill style=\'width:'+pct+'%\'></div></div>'+
        '<div class=gm-bar-q>'+x.q+'</div>'+
        '<div class=gm-bar-v>'+(x.v>0?fmtBRL(x.v):'—')+'</div>'+
      '</div>';
    }).join('');
  }
}

function sairTelaCheia(){
  if(root.classList.contains('fs-3d')){
    root.classList.remove('fs-3d');
    var b=q('[data-act=fs3d]');if(b)b.innerHTML='<svg width=12 height=12 viewBox=\'0 0 24 24\' fill=none stroke=currentColor stroke-width=2.2 stroke-linecap=round stroke-linejoin=round><polyline points=\'15 3 21 3 21 9\'/><polyline points=\'9 21 3 21 3 15\'/><line x1=\'21\' y1=\'3\' x2=\'14\' y2=\'10\'/><line x1=\'3\' y1=\'21\' x2=\'10\' y2=\'14\'/></svg>Expandir 3D';
    setTimeout(function(){if(window.__rpResize)window.__rpResize();},30);
  }
}

function irPara(id){
  sairTelaCheia();
  var s=document.getElementById(id);if(!s)return;
  s.open=true;rolarPara(s,12);
  s.style.boxShadow='0 0 0 3px #0284c7';
  setTimeout(function(){s.style.boxShadow='';},1200);
}

function ordenar(){
  var modo=ordSel?ordSel.value:'padrao';
  secs.forEach(function(s){
    var ul=q('.cards',s);if(!ul)return;
    var cs=qa('.card',ul);
    cs.sort(function(a,b){
      if(modo==='maior')return (b._v-a._v)||(a._i-b._i);
      if(modo==='menor')return (a._v-b._v)||(a._i-b._i);
      if(modo==='mun')return a._mun.localeCompare(b._mun,'pt-BR')||(b._v-a._v);
      if(modo==='az')return a._tit.localeCompare(b._tit,'pt-BR')||(a._i-b._i);
      return a._i-b._i;
    });
    cs.forEach(function(c){ul.appendChild(c);});
    atualizarPaginacaoSec(s,root.classList.contains('tem-filtro'));
  });
}

/* ---------- Filtro Universal (Diretoria + Município + Mesorregião + Busca) ---------- */

function atualizarPaginacaoSec(s,temFiltro){
  var cs=qa('.card:not(.oculto)',s);
  var n=cs.length;
  var ft=q('.sec-ft',s);
  var btn=q('.vm-btn',s);
  var isExp=s.classList.contains('expand');

  if(n<=6){
    if(ft)ft.style.display='none';
    cs.forEach(function(c){c.classList.remove('oculto-extra');});
  }else{
    if(ft)ft.style.display='flex';
    if(isExp){
      if(btn)btn.innerHTML=""<span>Mostrar menos (6 primeiros)</span> <svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><polyline points='18 15 12 9 6 15'/></svg>"";
      cs.forEach(function(c){c.classList.remove('oculto-extra');});
    }else{
      var b=q('.sec-n',s);
      var totOrig=b?(parseInt(b.getAttribute('data-total'),10)||n):n;
      var txtTotal=temFiltro?(n+' projetos filtrados'):(totOrig+' projetos');
      if(btn)btn.innerHTML=""<span>Ver todos os <b>""+txtTotal+""</b></span> <svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><polyline points='6 9 12 15 18 9'/></svg>"";
      cs.forEach(function(c,idx){
        if(idx>=6)c.classList.add('oculto-extra');
        else c.classList.remove('oculto-extra');
      });
    }
  }
}

function filtrar(){
  var termos=inp?norm(inp.value).split(/\s+/).filter(Boolean):[];
  var temTxt=termos.length>0,temDir=(qtdDirs()>0&&qtdDirs()<4),temFiltro=Boolean(temDir||munAtivo||(mesoAtiva>=0)||temTxt);
  var vis=0,somaVis=0,somaApv=0,munSet={},progVis=0,contagemPorSec={};

  cards.forEach(function(li){
    var ok=dirOk(li._d)&&(!munAtivo||li._mun===munAtivo)&&(mesoAtiva<0||li._mi===mesoAtiva)&&(!temTxt||termos.every(function(t){return li._t.indexOf(t)>-1;}));
    li.classList.toggle('oculto',!ok);
    if(ok){vis++;somaVis+=li._vc;somaApv+=li._va;if(li._mun)munSet[li._mun]=1;}
  });

  secs.forEach(function(s){
    var cs=qa('.card:not(.oculto)',s),n=cs.length,sv=0;
    cs.forEach(function(c){sv+=c._v;});
    var b=q('.sec-n',s),vl=q('.sec-val',s);
    var totOrig=parseInt(b?b.getAttribute('data-total'):n,10)||n;
    contagemPorSec[s.id]=temFiltro?n:totOrig;
    var esconder=temFiltro?(n===0):(false);
    s.classList.toggle('vazio',esconder);
    if(!esconder)progVis++;
    if(b)b.textContent=temFiltro?n:totOrig;
    if(vl){
      if(sv>0){vl.textContent=fmtBRL(sv);s.classList.remove('sec-soval');}
      else if(s.id==='s17'){vl.textContent='Acordo de Cooperação Técnica';s.classList.remove('sec-soval');}
      else{vl.textContent='';s.classList.add('sec-soval');}
    }
    if((temTxt||munAtivo||mesoAtiva>=0)&&n>0&&n<=30)s.open=true;
    atualizarPaginacaoSec(s,temFiltro);
  });

  chips.forEach(function(ch){
    var id=ch.getAttribute('data-go'),sec=document.getElementById(id);
    ch.classList.toggle('fora',Boolean(sec&&sec.classList.contains('vazio')));
  });

  muns.forEach(function(m){m.classList.toggle('on',Boolean(munAtivo&&norm(m.getAttribute('data-mun'))===munAtivo));});
  dirs.concat(fsDirs).forEach(function(x){var d=x.getAttribute('data-dir');if(!d){x.classList.toggle('on',qtdDirs()===0);}else{x.classList.toggle('on',Boolean(dirsAtivas[d]));}});

  if(munTag){
    if(munAtivo){munTag.style.display='inline-flex';munTag.textContent='Município: '+munLabel+' ✕';}
    else munTag.style.display='none';
  }
  if(mesoTag){
    if(mesoAtiva>=0&&MG_MESOS[mesoAtiva]){mesoTag.style.display='inline-flex';mesoTag.textContent='Região: '+MG_MESOS[mesoAtiva].n+' ✕';}
    else mesoTag.style.display='none';
  }

  /* atualiza indicadores geográficos do cabeçalho */
  if(gMun){
    if(munAtivo)gMun.textContent=munLabel;
    else{var nM=temFiltro?Object.keys(munSet).length:baseMun;gMun.textContent=nM===1?Object.keys(munSet).map(function(k){return munLabelMap[k]||k;})[0]:('Todos ('+nM+')');}
  }
  if(gMeso){
    if(mesoAtiva>=0&&MG_MESOS[mesoAtiva])gMeso.textContent=MG_MESOS[mesoAtiva].n;
    else if(munAtivo){var kL=ALIAS_MUN[munAtivo]||munAtivo;var inf=MG_MUNS[kL];gMeso.textContent=(inf&&MG_MESOS[inf[2]])?MG_MESOS[inf[2]].n:'Minas Gerais';}
    else gMeso.textContent='Todas as 12 regiões';
  }

  root.classList.toggle('filtrando-txt',temTxt);
  root.classList.toggle('tem-filtro',temFiltro);
  if(cnt)cnt.textContent=temFiltro?(vis.toLocaleString('pt-BR')+' / '+cards.length.toLocaleString('pt-BR')):cards.length.toLocaleString('pt-BR');
  if(semRes)semRes.style.display=(temFiltro&&!vis)?'block':'none';

  if(kProj)kProj.textContent=(temFiltro?vis:baseTotal).toLocaleString('pt-BR');
  if(kProg)kProg.textContent=(temFiltro?progVis:baseProg).toLocaleString('pt-BR');
  if(kMun)kMun.textContent=(temFiltro?Object.keys(munSet).length:baseMun).toLocaleString('pt-BR');
  if(kVal)kVal.textContent=temFiltro?fmtBRL(somaVis):baseValTxt;
  if(kValLbl)kValLbl.textContent=temFiltro?'Concedente (filtrado)':'Valor Concedente';
  if(kSub)kSub.textContent=temFiltro?('Geral: '+baseValTxt):'';
  if(kApv)kApv.textContent=temFiltro?fmtBRL(somaApv):baseApvTxt;
  var kApvLbl=q('#rp-kavl');if(kApvLbl)kApvLbl.textContent=temFiltro?'Aprovado (filtrado)':'Total com Contrapartida';
  var kApvSub=q('#rp-kas');if(kApvSub)kApvSub.textContent=temFiltro?('Geral: '+baseApvTxt):'Aporte global aprovado';
  if(totBar)totBar.innerHTML=temFiltro?('<span>Soma dos cartões filtrados ('+vis.toLocaleString('pt-BR')+')</span><b>Concedente: '+fmtBRL(somaVis)+' · Total c/ Contrapartida: '+fmtBRL(somaApv)+' <small style=font-weight:400;opacity:.75>(Geral: '+baseValTxt+' / '+baseApvTxt+')</small></b>'):('<span>Valor Concedente Total: <b>'+baseValTxt+'</b></span><span>Total Aprovado (c/ Contrapartida): <b>'+baseApvTxt+'</b></span>');
  if(resumoTxt)resumoTxt.innerHTML=temFiltro?('Exibindo <b>'+vis.toLocaleString('pt-BR')+'</b> de '+baseTotal.toLocaleString('pt-BR')+' projetos:'):('Distribuição dos <b>'+baseTotal.toLocaleString('pt-BR')+'</b> projetos por programa:');

  renderizarMatrizesDiretoria(contagemPorSec);
  atualizarGraficoMunicipios();
  if(atualizarCena3D)atualizarCena3D();
}

var tm;
if(inp){
  inp.addEventListener('input',function(){clearTimeout(tm);tm=setTimeout(filtrar,100);});
  inp.addEventListener('keydown',function(e){if(e.key==='Escape'){inp.value='';filtrar();}});
}
var munQ=q('#rp-munq');
if(munQ){
  munQ.addEventListener('input',function(){
    var v=norm(munQ.value);
    muns.forEach(function(m){m.classList.toggle('escondido',Boolean(v&&norm(m.textContent).indexOf(v)===-1));});
  });
}
if(ordSel)ordSel.addEventListener('change',ordenar);

/* ---------- Formatação Institucional e Cópia (Individual, Word e Excel) ---------- */
function txtOf(el){return el?(el.textContent||'').trim():'';}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

function formatarProjetoTexto(card){
  var tit=txtOf(card.querySelector('.card-t'))||'Sem título';
  var proj=card.getAttribute('data-proj')||'';
  var dir=card.getAttribute('data-dir')||'';
  var getV=function(k){
    var el=card.querySelector('[data-k='+k+']');
    var v=el?txtOf(el):'';
    return (v&&v!=='—'&&v!=='-')?v:'Não identificado';
  };
  var mun=getV('mun');
  var meso=getV('meso');
  var ano=getV('ano');
  var num=getV('num');
  var area=getV('area');
  var coord=getV('coord');
  var exec=getV('exec');
  var orgao=getV('orgao');
  var valConc=getV('valor');
  var valApv=getV('aprov');
  var resumo=getV('resumo');

  var linhas=[];
  linhas.push('PROPOSTA: '+tit);
  linhas.push('--------------------------------------------------------------------------------');
  if(proj)linhas.push('Programa: '+proj+(dir?' ('+dir+')':''));
  if(mun&&mun!=='Não identificado')linhas.push('Município: '+mun);
  if(meso&&meso!=='Não identificado')linhas.push('Mesorregião: '+meso);
  if(ano&&ano!=='Não identificado')linhas.push('Ano: '+ano);
  if(num&&num!=='Não identificado'&&num!=='Não se aplica')linhas.push('Edital / APQ: '+num);
  if(area&&area!=='Não identificado')linhas.push('Área de Conhecimento: '+area);
  if(coord&&coord!=='Não identificado')linhas.push('Coordenador(a): '+coord);
  if(exec&&exec!=='Não identificado')linhas.push('Executora / Proponente: '+exec);
  if(orgao&&orgao!=='Não identificado'&&orgao!=='N/A')linhas.push('Órgão Estadual: '+orgao);
  if(valConc&&valConc!=='Não identificado')linhas.push('Valor Concedente: '+valConc);
  if(valApv&&valApv!=='Não identificado')linhas.push('Total c/ Contrapartida: '+valApv);

  if(resumo&&resumo!=='Não informado'&&resumo!=='Não se aplica'&&resumo!=='Não identificado'){
    linhas.push('');
    linhas.push('Resumo da Proposta:');
    linhas.push(resumo);
  }
  return linhas.join('\r\n');
}

function formatarProjetoHtml(card){
  var tit=txtOf(card.querySelector('.card-t'))||'Sem título';
  var proj=card.getAttribute('data-proj')||'';
  var dir=card.getAttribute('data-dir')||'';
  var getV=function(k){
    var el=card.querySelector('[data-k='+k+']');
    var v=el?txtOf(el):'';
    return (v&&v!=='—'&&v!=='-')?v:'Não identificado';
  };
  var mun=getV('mun');
  var meso=getV('meso');
  var ano=getV('ano');
  var num=getV('num');
  var area=getV('area');
  var coord=getV('coord');
  var exec=getV('exec');
  var orgao=getV('orgao');
  var valConc=getV('valor');
  var valApv=getV('aprov');
  var resumo=getV('resumo');

  var h='<div style=""font-family:Segoe UI,Calibri,Arial,sans-serif;font-size:10pt;color:#1e293b;border:1px solid #cbd5e1;border-radius:6px;padding:10pt 12pt;margin-bottom:12pt;background:#ffffff;page-break-inside:avoid;"">';
  h+='<h3 style=""margin:0 0 6pt;font-size:11.5pt;font-weight:400;color:#0f172a;border-bottom:2px solid #0284c7;padding-bottom:3pt;"">'+esc(tit)+'</h3>';
  h+='<p style=""margin:0 0 6pt;line-height:1.5;"">';
  if(proj)h+='<b>Programa:</b> '+esc(proj)+(dir?' ('+esc(dir)+')':'')+'<br>';
  if(mun&&mun!=='Não identificado')h+='<b>Município:</b> '+esc(mun)+'<br>';
  if(meso&&meso!=='Não identificado')h+='<b>Mesorregião:</b> '+esc(meso)+'<br>';
  if(ano&&ano!=='Não identificado')h+='<b>Ano:</b> '+esc(ano)+'<br>';
  if(num&&num!=='Não identificado'&&num!=='Não se aplica')h+='<b>Edital / APQ:</b> '+esc(num)+'<br>';
  if(area&&area!=='Não identificado')h+='<b>Área de Conhecimento:</b> '+esc(area)+'<br>';
  if(coord&&coord!=='Não identificado')h+='<b>Coordenador(a):</b> '+esc(coord)+'<br>';
  if(exec&&exec!=='Não identificado')h+='<b>Executora / Proponente:</b> '+esc(exec)+'<br>';
  if(orgao&&orgao!=='Não identificado'&&orgao!=='N/A')h+='<b>Órgão Estadual:</b> '+esc(orgao)+'<br>';
  if(valConc&&valConc!=='Não identificado')h+='<b>Valor Concedente:</b> '+esc(valConc)+'<br>';
  if(valApv&&valApv!=='Não identificado')h+='<b>Total c/ Contrapartida:</b> '+esc(valApv)+'<br>';
  h+='</p>';
  if(resumo&&resumo!=='Não informado'&&resumo!=='Não se aplica'&&resumo!=='Não identificado'){
    h+='<div style=""margin-top:8pt;background:#f8fafc;padding:8pt 10pt;border-left:3px solid #0284c7;border-radius:4px;"">';
    h+='<p style=""margin:0 0 4pt 0;font-weight:bold;color:#0369a1;font-size:10pt;"">Resumo da Proposta:</p>';
    h+='<p style=""margin:0;line-height:1.5;color:#334155;font-size:9.5pt;"">'+esc(resumo)+'</p>';
    h+='</div>';
  }
  h+='</div>';
  return h;
}

function copiarClipboard(html,plain){
  var ok=false;
  var h=function(e){
    try{
      if(e.clipboardData){
        e.clipboardData.setData('text/html',html);
        e.clipboardData.setData('text/plain',plain);
        e.preventDefault();
        ok=true;
      }
    }catch(err){}
  };
  var aux=document.createElement('textarea');
  aux.value=plain;
  aux.className='rp-clip';
  root.appendChild(aux);
  aux.focus({preventScroll:true});
  aux.select();
  if(aux.setSelectionRange)aux.setSelectionRange(0,plain.length);
  document.addEventListener('copy',h);
  try{
    var res=document.execCommand('copy');
    if(res)ok=true;
  }catch(err){}
  document.removeEventListener('copy',h);
  root.removeChild(aux);
  return ok;
}

function copiarNo(no){
  var plain=formatarProjetoTexto(no);
  var html=formatarProjetoHtml(no);
  return copiarClipboard(html,plain);
}

function copiarExcel(){
  var cab=['Diretoria','Programa','Município','Mesorregião','Ano','Edital / APQ','Título da Proposta','Área de Conhecimento','Coordenador','Executora / Proponente','Órgão Estadual','Valor Concedente','Total com Contrapartida','Resumo'];
  var ch=['mun','meso','ano','num','tit','area','coord','exec','orgao','valor','aprov','resumo'];
  var tb=document.createElement('table');
  tb.style.borderCollapse='collapse';
  function cel(tag,txt){
    var e=document.createElement(tag);
    e.textContent=txt;
    e.style.border='1px solid #cbd5e1';
    e.style.padding='5px 8px';
    if(tag==='th'){e.style.background='#0f172a';e.style.color='#ffffff';e.style.fontWeight='bold';}
    return e;
  }
  var tr=document.createElement('tr');
  cab.forEach(function(x){tr.appendChild(cel('th',x));});
  tb.appendChild(tr);

  var linhas=[cab.join('\t')],n=0;
  qa('.sec:not(.vazio) .card:not(.oculto)').forEach(function(li){
    var v=[li.getAttribute('data-dir')||'',li.getAttribute('data-proj')||''].concat(ch.map(function(k){
      var e=li.querySelector('[data-k='+k+']');
      return e?e.textContent.replace(/\s+/g,' ').trim():'';
    }));
    var r=document.createElement('tr');
    v.forEach(function(x){r.appendChild(cel('td',x));});
    tb.appendChild(r);
    linhas.push(v.join('\t'));
    n++;
  });
  var html=tb.outerHTML,plain=linhas.join('\r\n');
  return copiarClipboard(html,plain)?n:-1;
}

function copiarWord(){
  var Q=String.fromCharCode(39);
  var F='font-family:Calibri,Arial,sans-serif;';
  var hoje=new Date().toLocaleDateString('pt-BR');
  var vis=0,somaConc=0,somaApv=0;
  var filtros=[];
  if(qtdDirs()>0&&qtdDirs()<4)filtros.push('Diretoria(s): '+Object.keys(dirsAtivas).join(', '));
  if(munAtivo)filtros.push('Município: '+munLabel);
  if(mesoAtiva>=0&&MG_MESOS[mesoAtiva])filtros.push('Mesorregião: '+MG_MESOS[mesoAtiva].n);
  if(inp&&inp.value.trim())filtros.push('Busca: '+inp.value.trim());

  var corpoHtml='';
  var blocosPlain=[];

  qa('.sec:not(.vazio)').forEach(function(s){
    var cs=qa('.card:not(.oculto)',s);
    if(!cs.length)return;
    var nome=(q('.sec-t',s)||{textContent:''}).textContent.trim();
    var dir=s.getAttribute('data-dir')||'';
    var svConc=0,svApv=0;

    var secHeader='================================================================================\r\n'+
                  'PROGRAMA: '+nome+' ('+dir+') - '+cs.length+' projeto(s)\r\n'+
                  '================================================================================';
    blocosPlain.push(secHeader);

    var blocoHtmlCards=cs.map(function(li,i){
      svConc+=li._vc||0;
      svApv+=li._va||0;
      vis++;
      blocosPlain.push((i+1)+'. '+formatarProjetoTexto(li));
      return formatarProjetoHtml(li);
    }).join('<hr style=""border:none;border-top:1px solid #cbd5e1;margin:12pt 0;"">');

    somaConc+=svConc;
    somaApv+=svApv;

    var stH2=F+'font-size:13pt;color:#1F3864;margin:18pt 0 8pt;border-bottom:2px solid #1F3864;padding-bottom:3pt;';
    var stSub='font-weight:normal;color:#595959;font-size:10.5pt;';
    corpoHtml+='<h2 style='+Q+stH2+Q+'>'+esc(nome)+' <span style='+Q+stSub+Q+'>('+dir+' · '+cs.length+' projeto(s) · Concedente: '+fmtBRL(svConc)+' · Contrapartida: '+fmtBRL(svApv)+')</span></h2>'+blocoHtmlCards;
  });

  var stWrap=F+'color:#000;line-height:1.35;';
  var stCab=F+'font-size:9.5pt;color:#595959;margin:0 0 2pt;';
  var stH1=F+'font-size:16pt;color:#1F3864;margin:0 0 4pt;';
  var stData=F+'font-size:10pt;color:#404040;margin:0 0 12pt;';
  var stKpiBox=F+'background:#F2F4F8;border-left:4px solid #1F3864;padding:8pt 12pt;margin-bottom:16pt;';
  var stKpiP=F+'font-size:10pt;margin:2pt 0;';
  var stObs=F+'font-size:8.5pt;color:#595959;margin-top:16pt;border-top:1px solid #D9D9D9;padding-top:6pt;';

  var html='<div style='+Q+stWrap+Q+'>'+
    '<p style='+Q+stCab+Q+'>Governo do Estado de Minas Gerais · Secretaria de Estado de Desenvolvimento Econômico · SUBINOVA</p>'+
    '<h1 style='+Q+stH1+Q+'>Relatório de Projetos por Programa</h1>'+
    '<p style='+Q+stData+Q+'>Data de emissão: '+hoje+(filtros.length?' · Filtros aplicados: '+esc(filtros.join('; ')):' · Sem filtros locais aplicados')+'</p>'+
    '<div style='+Q+stKpiBox+Q+'>'+
      '<p style='+Q+stKpiP+Q+'><b>Total de Projetos Filtrados:</b> '+vis.toLocaleString('pt-BR')+'</p>'+
      '<p style='+Q+stKpiP+Q+'><b>Valor Concedente (soma dos projetos filtrados):</b> '+fmtBRL(somaConc)+'</p>'+
      '<p style='+Q+stKpiP+Q+'><b>Total com Contrapartida (soma dos projetos filtrados):</b> '+fmtBRL(somaApv)+'</p>'+
      '<p style='+Q+stKpiP+Q+'><b>Valor Concedente Geral:</b> '+esc(baseValTxt)+'</p>'+
      '<p style='+Q+stKpiP+Q+'><b>Total Aprovado com Contrapartida Geral:</b> '+esc(baseApvTxt)+'</p>'+
    '</div>'+
    corpoHtml+
    '<p style='+Q+stObs+Q+'><b>Observação:</b> O valor contratado é superior ao solicitado devido à ausência de dados de solicitação em determinados editais e projetos. Os programas Pró-Inovação, PCTI e Incremento da Maturidade contabilizam exclusivamente valores contratados, e o valor total via TecPop foi rateado igualmente entre os municípios atendidos.</p>'+
  '</div>';

  var plainLinhas=[
    'GOVERNO DO ESTADO DE MINAS GERAIS',
    'SECRETARIA DE ESTADO DE DESENVOLVIMENTO ECONÔMICO - SUBINOVA',
    'RELATÓRIO DE PROJETOS POR PROGRAMA',
    'Data de emissão: '+hoje,
    filtros.length?('Filtros aplicados: '+filtros.join('; ')):'Sem filtros locais aplicados',
    'Total de projetos filtrados: '+vis.toLocaleString('pt-BR')+' | Concedente: '+fmtBRL(somaConc)+' | Total c/ Contrapartida: '+fmtBRL(somaApv),
    '',
    blocosPlain.join('\r\n\r\n================================================================================\r\n\r\n'),
    '',
    '================================================================================',
    'Observação: O valor contratado é superior ao solicitado devido à ausência de dados de solicitação em determinados editais e projetos.'
  ];
  var plain=plainLinhas.join('\r\n');

  return copiarClipboard(html,plain)?vis:-1;
}

/* ---------- eventos de clique ---------- */
root.addEventListener('click',function(e){
  var go=e.target.closest('[data-go]');
  if(go){e.preventDefault();irPara(go.getAttribute('data-go'));return;}
  var vm=e.target.closest('.vm');
  if(vm){
    e.preventDefault();
    modo3D=vm.getAttribute('data-vm')||'mun';
    qa('.vm').forEach(function(x){x.classList.toggle('on',x===vm);});
    if(atualizarCena3D)atualizarCena3D(true);
    return;
  }
  var db=e.target.closest('.dir,.fs-dir,.dcard-h');
  if(db){
    e.preventDefault();
    var nv=db.getAttribute('data-dir')||'';
    if(!nv){
      dirsAtivas={};
    }else{
      if(dirsAtivas[nv]){
        delete dirsAtivas[nv];
      }else{
        dirsAtivas[nv]=true;
      }
      if(qtdDirs()===4){
        dirsAtivas={};
      }
    }
    filtrar();return;
  }
  var mb=e.target.closest('[data-mun]');
  if(mb){
    e.preventDefault();
    var raw=mb.getAttribute('data-mun')||'',nm=norm(raw);
    if(munAtivo===nm){
      munAtivo='';munLabel='';
    }else{
      munAtivo=nm;munLabel=raw;
      if(mb.closest('#rp-gmodal')&&modo3D!=='mun'){
        modo3D='mun';
        qa('.vm').forEach(function(x){x.classList.toggle('on',x.getAttribute('data-vm')==='mun');});
      }
    }
    filtrar();return;
  }
  var vmBtn=e.target.closest('.vm-btn');
  if(vmBtn){
    e.preventDefault();
    var s=vmBtn.closest('.sec');
    if(s){
      var exp=s.classList.toggle('expand');
      atualizarPaginacaoSec(s,root.classList.contains('tem-filtro'));
      if(!exp)rolarPara(s,10);
    }
    return;
  }
  var cp=e.target.closest('.cp');
  if(cp){e.preventDefault();toast(copiarNo(cp.closest('.card'))?'Projeto copiado para a área de transferência':'Não foi possível copiar');return;}
  var b=e.target.closest('[data-act]');if(!b)return;
  var a=b.getAttribute('data-act');
  if(a==='abrir'){
    secs.forEach(function(s){
      if(!s.classList.contains('vazio')){
        s.open=true;
        s.classList.add('expand');
        atualizarPaginacaoSec(s,root.classList.contains('tem-filtro'));
      }
    });
  } else if(a==='fechar'){
    secs.forEach(function(s){
      s.classList.remove('expand');
      atualizarPaginacaoSec(s,root.classList.contains('tem-filtro'));
      s.open=false;
    });
  }
  else if(a==='texto'){var nw=copiarWord();toast(nw>=0?'Relatório formal copiado ('+nw+' projetos). Cole no Word com Ctrl+V':'Não foi possível copiar');}
  else if(a==='excel'){var ne=copiarExcel();toast(ne>=0?ne+' registro(s) copiados para colar no Excel':'Não foi possível copiar');}
  else if(a==='limpar')filtrar(inp.value='');
  else if(a==='limpar-mun'){munAtivo='';munLabel='';filtrar();}
  else if(a==='limpar-meso'){mesoAtiva=-1;filtrar();}
  else if(a==='limpar-tudo'){dirsAtivas={};munAtivo='';munLabel='';mesoAtiva=-1;if(inp)inp.value='';filtrar();}
  else if(a==='grafico'){
    var gm=q('#rp-gmodal'),bg=q('[data-act=grafico]');
    if(gm){var on=!gm.classList.contains('on');gm.classList.toggle('on',on);if(bg)bg.classList.toggle('on',on);if(on){atualizarGraficoMunicipios();rolarPara(gm,72);}}
  }
  else if(a==='fechar-grafico'){
    var gm2=q('#rp-gmodal'),bg2=q('[data-act=grafico]');
    if(gm2)gm2.classList.remove('on');if(bg2)bg2.classList.remove('on');
  }
  else if(a==='topo'){var sc=scroller();if(sc.scrollTo)sc.scrollTo({top:0,behavior:'smooth'});else sc.scrollTop=0;}
  else if(a==='fs3d'){
    var on=!root.classList.contains('fs-3d');
    root.classList.toggle('fs-3d',on);
    b.innerHTML=on?'<svg width=12 height=12 viewBox=\'0 0 24 24\' fill=none stroke=currentColor stroke-width=2.2 stroke-linecap=round stroke-linejoin=round><polyline points=\'4 14 10 14 10 20\'/><polyline points=\'20 10 14 10 14 4\'/><line x1=\'14\' y1=\'10\' x2=\'21\' y2=\'3\'/><line x1=\'3\' y1=\'21\' x2=\'10\' y2=\'14\'/></svg>Reduzir':'<svg width=12 height=12 viewBox=\'0 0 24 24\' fill=none stroke=currentColor stroke-width=2.2 stroke-linecap=round stroke-linejoin=round><polyline points=\'15 3 21 3 21 9\'/><polyline points=\'9 21 3 21 3 15\'/><line x1=\'21\' y1=\'3\' x2=\'14\' y2=\'10\'/><line x1=\'3\' y1=\'21\' x2=\'10\' y2=\'14\'/></svg>Expandir 3D';
    setTimeout(function(){if(window.__rpResize)window.__rpResize();},30);
  }
  else if(a==='zin'&&window.__rpZoom)window.__rpZoom(-1.8);
  else if(a==='zout'&&window.__rpZoom)window.__rpZoom(1.8);
  else if(a==='zreset'&&window.__rpReset)window.__rpReset();
});

var topo=q('.topo');
if(window.__rpScroll)window.removeEventListener('scroll',window.__rpScroll,true);
window.__rpScroll=function(){var sc=scroller();if(topo&&sc)topo.classList.toggle('on',(sc.scrollTop||window.pageYOffset||0)>320);};
window.addEventListener('scroll',window.__rpScroll,true);

function grafico2D(){
  var hero=q('.hero'),box=q('.bars2d');if(!hero||!box)return;
  hero.classList.add('sem3d');if(box.childNodes.length)return;
  var d=window.RP_DATA||[],max=Math.max.apply(null,d.map(function(x){return x.q;}).concat([1]));
  d.forEach(function(x){
    var row=document.createElement('div');row.className='b2';row.setAttribute('data-go',x.s);row.title=x.d+' · '+x.n+': '+x.q;
    var s=document.createElement('span');s.textContent=x.n;
    var em=document.createElement('em'),i=document.createElement('i');i.style.width=Math.max(2,Math.round(100*x.q/max))+'%';i.style.background=x.c;em.appendChild(i);
    var b=document.createElement('b');b.textContent=x.q;
    row.appendChild(s);row.appendChild(em);row.appendChild(b);box.appendChild(row);
  });
}

/* ================================================================================================
   VISUALIZAÇÃO 3D THREE.JS:
   1. MAPA 3D DE MINAS GERAIS (Por Município e Por Região com Beacon Highlight e Camera Glide)
   2. MATRIZ ARQUITETÔNICA 3D DAS 4 DIRETORIAS (Cidadela de Inovação 3D com torres dinâmicas)
   ================================================================================================ */
function iniciar3D(){
  var T=window.THREE,hero=q('.hero'),cv=q('#rp-3d'),tip=q('#rp-tip'),dados=window.RP_DATA||[];
  if(!T||!cv||!dados.length){grafico2D();return;}
  if(window.__rp3d){try{window.__rp3d();}catch(err){}}
  var ren;try{ren=new T.WebGLRenderer({canvas:cv,antialias:true,alpha:true});}catch(err){grafico2D();return;}
  hero.classList.remove('sem3d');
  var W=cv.clientWidth||520,H=cv.clientHeight||212;
  ren.setPixelRatio(Math.min(window.devicePixelRatio||1,2));ren.setSize(W,H,false);
  var cena=new T.Scene(),cam=new T.PerspectiveCamera(32,W/H,0.1,250);
  cena.add(new T.AmbientLight(0xdbeafe,0.78));
  var l1=new T.DirectionalLight(0xffffff,0.95);l1.position.set(8,16,11);cena.add(l1);
  var l2=new T.DirectionalLight(0x38bdf8,0.42);l2.position.set(-10,8,-8);cena.add(l2);

  var palco=new T.Group();cena.add(palco);
  var grpMapa=new T.Group(),grpProgs=new T.Group();
  palco.add(grpMapa);palco.add(grpProgs);

  var corDir={DPD:0x2563eb,DCTT:0x0891b2,DIPRO:0x0d9488,DIAE:0x4f46e5};
  var hexDir={DPD:'#2563eb',DCTT:'#0891b2',DIPRO:'#0d9488',DIAE:'#4f46e5'};

  function criarSprite(txt,corBg,altBase){
    var c=document.createElement('canvas');
    var g=c.getContext('2d');
    var font='700 24px Segoe UI, sans-serif';
    g.font=font;
    var metrics=g.measureText(txt);
    var txtW=Math.ceil(metrics.width);
    var padX=20;
    var boxW=Math.max(76,txtW+padX*2);
    var boxH=46;

    c.width=boxW*2;
    c.height=boxH*2;
    g.scale(2,2);

    if(corBg){
      g.fillStyle='rgba(9,25,41,0.94)';
      g.strokeStyle=corBg;
      g.lineWidth=2.5;
      var bx=2,by=2,bw=boxW-4,bh=boxH-4;
      g.beginPath();
      if(g.roundRect)g.roundRect(bx,by,bw,bh,7);
      else g.rect(bx,by,bw,bh);
      g.fill();
      g.stroke();
    }
    g.font=font;
    g.textAlign='center';
    g.textBaseline='middle';
    g.fillStyle='#f8fafc';
    g.fillText(txt,boxW/2,boxH/2);

    var tex=new T.CanvasTexture(c);
    tex.minFilter=T.LinearFilter;
    var s=new T.Sprite(new T.SpriteMaterial({map:tex,transparent:true,depthWrite:false}));
    var h3D=altBase||0.32;
    var w3D=h3D*(boxW/boxH);
    s.scale.set(w3D,h3D,1);
    return s;
  }

  /* 1) Construção do Mapa 3D de Minas Gerais (12 Mesorregiões extrudadas) */
  var malhasMeso=[],bordasMeso=[];
  MG_MESOS.forEach(function(ms,idx){
    var sh=new T.Shape();
    ms.p.forEach(function(pt,i){if(i===0)sh.moveTo(pt[0],-pt[1]);else sh.lineTo(pt[0],-pt[1]);});
    var geo=new T.ExtrudeGeometry(sh,{depth:0.24,bevelEnabled:true,bevelSegments:1,steps:1,bevelSize:0.02,bevelThickness:0.02});
    geo.rotateX(-Math.PI/2);
    var mat=new T.MeshStandardMaterial({color:0x102a42,emissive:0x0ea5e9,emissiveIntensity:0.04,metalness:0.22,roughness:0.62,transparent:true,opacity:0.96});
    var mesh=new T.Mesh(geo,mat);
    mesh.userData={tipo:'meso',idx:idx,n:ms.n,c:ms.c,q:0,v:0,muns:0,hy:1};
    grpMapa.add(mesh);malhasMeso.push(mesh);

    var pts3=ms.p.map(function(pt){return new T.Vector3(pt[0],0.265,pt[1]);});
    pts3.push(pts3[0].clone());
    var lgeo=new T.BufferGeometry().setFromPoints(pts3);
    var lmat=new T.LineBasicMaterial({color:0x38bdf8,transparent:true,opacity:0.48});
    var line=new T.Line(lgeo,lmat);
    grpMapa.add(line);bordasMeso.push(line);
  });

  var anelMapa=new T.Mesh(new T.RingGeometry(5.65,5.72,96),new T.MeshBasicMaterial({color:0x1e3a52,side:T.DoubleSide,transparent:true,opacity:0.45}));
  anelMapa.rotation.x=Math.PI/2;anelMapa.position.y=-0.02;grpMapa.add(anelMapa);

  var barrasMun=[],labelsMun=[];
  var geoTorre=new T.BoxGeometry(0.26,1,0.26);geoTorre.translate(0,0.5,0);
  var geoTorreMeso=new T.BoxGeometry(0.42,1,0.42);geoTorreMeso.translate(0,0.5,0);

  function reconstruirMapa(){
    barrasMun.forEach(function(b){grpMapa.remove(b);if(b.material)b.material.dispose();});
    labelsMun.forEach(function(l){grpMapa.remove(l);if(l.material&&l.material.map)l.material.map.dispose();});
    barrasMun=[];labelsMun=[];
    malhasMeso.forEach(function(m){m.userData.q=0;m.userData.v=0;m.userData.muns=0;m.userData.porDir={DPD:0,DCTT:0,DIPRO:0,DIAE:0};});

    var termos=inp?norm(inp.value).split(/\s+/).filter(Boolean):[];
    var temTxt=termos.length>0;

    var aggMun={};
    cards.forEach(function(li){
      var okBase=dirOk(li._d)&&(!temTxt||termos.every(function(t){return li._t.indexOf(t)>-1;}));
      if(!okBase)return;
      var k=ALIAS_MUN[li._mun]||li._mun;
      var info=MG_MUNS[k];
      if(!info)return;
      var ms=malhasMeso[info[2]];
      if(ms){ms.userData.q++;ms.userData.v+=li._v;if(ms.userData.porDir[li._d]!==undefined)ms.userData.porDir[li._d]++;}
      if(mesoAtiva>=0&&info[2]!==mesoAtiva)return;
      var entry=aggMun[k];
      if(!entry){
        entry=aggMun[k]={k:k,mun:li._mun,raw:munLabelMap[li._mun]||li._munRaw||k.toUpperCase(),x:info[0],z:info[1],mi:info[2],q:0,v:0,porDir:{DPD:0,DCTT:0,DIPRO:0,DIAE:0}};
      }
      entry.q++;entry.v+=li._v;
      if(entry.porDir[li._d]!==undefined)entry.porDir[li._d]++;
    });

    var munsPorMeso={};
    cards.forEach(function(li){
      if(li.classList.contains('oculto')&&mesoAtiva<0&&!munAtivo)return;
      var k=ALIAS_MUN[li._mun]||li._mun,info=MG_MUNS[k];
      if(info){munsPorMeso[info[2]]=munsPorMeso[info[2]]||{};munsPorMeso[info[2]][k]=1;}
    });
    malhasMeso.forEach(function(m,idx){m.userData.muns=munsPorMeso[idx]?Object.keys(munsPorMeso[idx]).length:0;});

    var maxMeso=Math.max.apply(null,malhasMeso.map(function(m){return m.userData.q;}).concat([1]));
    malhasMeso.forEach(function(m,idx){
      var r=m.userData.q/maxMeso;
      var sel=(mesoAtiva===idx);
      var sDir=dirAtivaSingle(),cBase=new T.Color(0x0c2136),cAtivo=new T.Color(sel?0x38bdf8:(sDir?(corDir[sDir]||0x0284c7):0x0369a1));
      m.material.color.copy(cBase).lerp(cAtivo,sel?0.88:Math.min(0.82,0.16+Math.sqrt(r)*0.64));
      m.material.emissiveIntensity=sel?0.28:(m.userData.q>0?(0.04+r*0.16):0.01);
      m.userData.hAlvo=(modo3D==='meso')?(1+r*1.45):1;
    });

    if(modo3D==='mun'){
      var lista=Object.keys(aggMun).map(function(k){return aggMun[k];});
      lista.sort(function(a,b){return b.q-a.q;});
      var maxMun=lista.length?lista[0].q:1;
      var temMunSel=Boolean(munAtivo);
      var munSelInfo=null;

      lista.forEach(function(e,idx){
        var isSel=(munAtivo&&e.mun===munAtivo);
        if(isSel)munSelInfo=e;

        var domDir='DPD',maxD=-1;
        ['DPD','DCTT','DIPRO','DIAE'].forEach(function(d){if(dirOk(d)&&e.porDir[d]>maxD){maxD=e.porDir[d];domDir=d;}});
        var sDir=dirAtivaSingle();
        var hex=isSel?'#facc15':(sDir?(hexDir[sDir]||'#0284c7'):(hexDir[domDir]||'#0284c7'));
        var cor=new T.Color(hex);

        var hBase=0.28+2.45*Math.pow(e.q/maxMun,0.55);
        var hAlvo=isSel?Math.max(2.5,hBase*1.5):(temMunSel?Math.max(0.12,hBase*0.35):hBase);
        var wAlvo=isSel?1.6:(temMunSel?0.65:((e.q>=25)?1.25:((e.q>=5)?1.05:0.88)));
        var opac=isSel?1.0:(temMunSel?0.22:0.96);
        var emissiveInt=isSel?0.92:(temMunSel?0.06:0.28);

        var mat=new T.MeshStandardMaterial({
          color:cor,
          emissive:isSel?0xfacc15:cor,
          emissiveIntensity:emissiveInt,
          metalness:0.18,
          roughness:0.28,
          transparent:true,
          opacity:opac
        });
        var m=new T.Mesh(geoTorre,mat);
        m.position.set(e.x,0.25,e.z);
        m.scale.set(wAlvo,hAlvo,wAlvo);

        var lb=null;
        if(isSel){
          lb=criarSprite(e.raw+' ('+e.q+')','#facc15',0.44);
          lb.position.set(e.x,0.25+hAlvo+0.42,e.z);
          grpMapa.add(lb);labelsMun.push(lb);
        }else if(!temMunSel&&idx<6){
          lb=criarSprite(e.q.toLocaleString('pt-BR'),hex);
          lb.position.set(e.x,0.25+hAlvo+0.26,e.z);
          grpMapa.add(lb);labelsMun.push(lb);
        }
        m.userData={tipo:'mun',e:e,h:hAlvo,hy:hAlvo,w:wAlvo,s:wAlvo,c:hex,dom:domDir,lb:lb,isSel:isSel};
        grpMapa.add(m);barrasMun.push(m);
      });

      if(temMunSel&&munSelInfo){
        var mesoIdx=munSelInfo.mi;
        if(mesoIdx!==undefined&&malhasMeso[mesoIdx]){
          malhasMeso[mesoIdx].material.color.setHex(0x0284c7);
          malhasMeso[mesoIdx].material.emissive.setHex(0x38bdf8);
          malhasMeso[mesoIdx].material.emissiveIntensity=0.45;
          malhasMeso[mesoIdx].userData.hAlvo=1.65;
        }
        panAlvoX=munSelInfo.x;panAlvoZ=munSelInfo.z;distAlvo=8.5;elevAlvo=0.62;
      }else{
        panAlvoX=0.35;panAlvoZ=0.45;distAlvo=11.2;elevAlvo=0.66;
      }
    }else if(modo3D==='meso'){
      malhasMeso.forEach(function(ms,idx){
        var u=ms.userData;if(!u.q)return;
        var domDir='DPD',maxD=-1;
        ['DPD','DCTT','DIPRO','DIAE'].forEach(function(d){if(dirOk(d)&&u.porDir[d]>maxD){maxD=u.porDir[d];domDir=d;}});
        var sDir=dirAtivaSingle();
        var hex=sDir?(hexDir[sDir]||'#0284c7'):(hexDir[domDir]||'#0284c7');
        var cor=new T.Color(hex);
        var hAlvo=0.22+1.88*Math.pow(u.q/maxMeso,0.52);
        var mat=new T.MeshStandardMaterial({color:cor,emissive:cor,emissiveIntensity:0.32,metalness:0.18,roughness:0.28,transparent:true,opacity:0.96});
        var m=new T.Mesh(geoTorreMeso,mat);
        var yBase=0.24*u.hAlvo;
        m.position.set(u.c[0],yBase,u.c[1]);
        m.scale.set(1,hAlvo,1);
        var lb=criarSprite(u.q.toLocaleString('pt-BR'),hex);
        lb.position.set(u.c[0],yBase+hAlvo+0.28,u.c[1]);
        grpMapa.add(lb);labelsMun.push(lb);
        m.userData={tipo:'meso-bar',idx:idx,n:u.n,q:u.q,v:u.v,muns:u.muns,porDir:u.porDir,h:hAlvo,hy:hAlvo,yBase:yBase,w:1,s:1,c:hex,lb:lb};
        grpMapa.add(m);barrasMun.push(m);
      });
      panAlvoX=0.35;panAlvoZ=0.45;distAlvo=11.2;elevAlvo=0.66;
    }
  }

  /* 2) Construção da Matriz Arquitetônica 3D das 4 Diretorias (Cidadela de Inovação 3D) */
  var DIR_CONFIG = [
    { d: 'DPD',   nome: 'Pesquisa e Desenvolvimento',               cor: '#2563eb', x: -4.4, z: -3.0, w: 5.2, h: 3.4 },
    { d: 'DCTT',  nome: 'Ciência e Transferência de Tecnologia',     cor: '#0284c7', x:  4.4, z: -3.0, w: 6.0, h: 3.4 },
    { d: 'DIPRO', nome: 'Inovação para o Setor Produtivo',          cor: '#0d9488', x: -4.4, z:  2.8, w: 5.2, h: 3.0 },
    { d: 'DIAE',  nome: 'Inovação Aberta e Empreendedorismo',       cor: '#4f46e5', x:  4.4, z:  2.8, w: 5.2, h: 3.0 }
  ];

  var barrasProg=[],labelsProg=[],podiumsProg=[];
  var geoHex=new T.CylinderGeometry(0.38,0.44,1,6);geoHex.translate(0,0.5,0);

  function reconstruirProgs(){
    barrasProg.forEach(function(b){grpProgs.remove(b);if(b.material)b.material.dispose();});
    labelsProg.forEach(function(l){grpProgs.remove(l);if(l.material&&l.material.map)l.material.map.dispose();});
    podiumsProg.forEach(function(p){grpProgs.remove(p);if(p.material)p.material.dispose();});
    barrasProg=[];labelsProg=[];podiumsProg=[];

    var stats={};
    (window.RP_DATA||[]).forEach(function(p){
      stats[p.s]={s:p.s,n:p.n,d:p.d,c:p.c,q:0,v:0};
    });

    var termos=inp?norm(inp.value).split(/\s+/).filter(Boolean):[];
    var temTxt=termos.length>0;

    cards.forEach(function(li){
      var ok=dirOk(li._d)&&(!munAtivo||li._mun===munAtivo)&&(mesoAtiva<0||li._mi===mesoAtiva)&&(!temTxt||termos.every(function(t){return li._t.indexOf(t)>-1;}));
      if(ok){
        var s=li.closest('.sec');
        if(s&&stats[s.id]){
          stats[s.id].q++;
          stats[s.id].v+=(li._v||0);
        }
      }
    });

    var maxP=1;
    Object.keys(stats).forEach(function(k){if(stats[k].q>maxP)maxP=stats[k].q;});

    /* Hub central iluminado */
    var hubGeo=new T.CylinderGeometry(1.35,1.45,0.14,48);
    var hubMat=new T.MeshStandardMaterial({color:0x0f2740,metalness:0.35,roughness:0.5});
    var hub=new T.Mesh(hubGeo,hubMat);
    hub.position.set(0,-0.07,-0.1);
    grpProgs.add(hub);podiumsProg.push(hub);

    var hubRing=new T.Mesh(new T.RingGeometry(1.55,1.62,64),new T.MeshBasicMaterial({color:0x38bdf8,side:T.DoubleSide,transparent:true,opacity:0.65}));
    hubRing.rotation.x=Math.PI/2;hubRing.position.set(0,0.01,-0.1);
    grpProgs.add(hubRing);podiumsProg.push(hubRing);

    DIR_CONFIG.forEach(function(dm){
      var isDirAtiva=dirOk(dm.d);
      var podOpac=isDirAtiva?0.95:0.22;

      var podGeo=new T.BoxGeometry(dm.w,0.16,dm.h);
      var podMat=new T.MeshStandardMaterial({
        color:isDirAtiva?0x0c2136:0x08131e,
        metalness:0.28,
        roughness:0.55,
        transparent:true,
        opacity:podOpac
      });
      var pod=new T.Mesh(podGeo,podMat);
      pod.position.set(dm.x,-0.08,dm.z);
      grpProgs.add(pod);podiumsProg.push(pod);

      var edges=new T.EdgesGeometry(podGeo);
      var wireMat=new T.LineBasicMaterial({
        color:new T.Color(dm.cor),
        transparent:true,
        opacity:isDirAtiva?0.85:0.2
      });
      var wire=new T.LineSegments(edges,wireMat);
      wire.position.copy(pod.position);
      grpProgs.add(wire);podiumsProg.push(wire);

      var progsInDir=(window.RP_DATA||[]).filter(function(p){return p.d===dm.d;});
      var nProgs=progsInDir.length;
      var cols=(nProgs>5)?4:((nProgs>3)?3:nProgs);

      var dirTotQ=0,dirTotV=0;

      progsInDir.forEach(function(p,i){
        var st=stats[p.s]||{q:0,v:0};
        dirTotQ+=st.q;
        dirTotV+=st.v;

        var r=(nProgs>3)?Math.floor(i/cols):0;
        var c=(nProgs>3)?(i%cols):i;
        var totalInRow=(r===0&&nProgs>3)?Math.min(cols,nProgs):(nProgs-cols);
        if(nProgs<=3)totalInRow=nProgs;

        var startX=dm.x-(dm.w-1.0)/2+(dm.w-1.0-(totalInRow-1)*1.15)/2;
        var px=startX+c*1.15;
        var pz=dm.z-(dm.h/2-0.7)+r*1.25;

        var temProjs=(st.q>0);
        var hFinal=temProjs?(0.28+2.95*Math.sqrt(st.q/maxP)):0.05;
        var opacTower=isDirAtiva?(temProjs?1.0:0.22):0.15;
        var emissiveInt=temProjs&&isDirAtiva?0.22:0.02;

        var col=new T.Color(p.c);
        var mat=new T.MeshStandardMaterial({
          color:col,
          emissive:col,
          emissiveIntensity:emissiveInt,
          metalness:0.22,
          roughness:0.35,
          transparent:true,
          opacity:opacTower
        });

        var tower=new T.Mesh(geoHex,mat);
        tower.position.set(px,0,pz);
        tower.scale.set(1,hFinal,1);

        var lb=null;
        if(temProjs&&isDirAtiva){
          lb=criarSprite(st.q.toLocaleString('pt-BR'),null);
          lb.position.set(px,hFinal+0.28,pz);
          grpProgs.add(lb);labelsProg.push(lb);
        }

        tower.userData={
          tipo:'prog',
          d:{s:p.s,n:p.n,d:p.d,c:p.c,q:st.q,v:st.v,qGeral:p.q},
          h:hFinal,
          hy:hFinal,
          s:1,
          lb:lb
        };
        grpProgs.add(tower);barrasProg.push(tower);
      });

      var badgeTxt=dm.d+' · '+dirTotQ+' proj.';
      var dirBadge=criarSprite(badgeTxt,dm.cor,0.34);
      dirBadge.position.set(dm.x,0.22,dm.z+dm.h/2+0.18);
      grpProgs.add(dirBadge);labelsProg.push(dirBadge);
    });
  }

  /* Câmera com Suavização de Glide (Pan e Zoom Animados) */
  var dist=11.2,elev=0.66,rotY=0,velY=0,panX=0.35,panZ=0.45;
  var distAlvo=11.2,elevAlvo=0.66,panAlvoX=0.35,panAlvoZ=0.45;

  function enquadrar(){
    cam.aspect=W/H;
    var fator=(W/H<1.45)?1.22:1;
    var d=dist*fator;
    cam.position.set(panX,d*Math.sin(elev),panZ+d*Math.cos(elev));
    cam.lookAt(panX,0.35,panZ);
    cam.updateProjectionMatrix();
  }

  window.__rpZoom=function(delta){
    distAlvo=Math.max(4.5,Math.min(22,distAlvo+delta));
  };
  window.__rpReset=function(){
    if(modo3D!=='progs'){distAlvo=11.2;elevAlvo=0.66;rotY=0;panAlvoX=0.35;panAlvoZ=0.45;}
    else{distAlvo=12.8;elevAlvo=0.55;rotY=0;panAlvoX=0;panAlvoZ=0;}
    velY=0;palco.rotation.y=0;
  };

  atualizarCena3D=function(trocaModo){
    grpMapa.visible=(modo3D!=='progs');
    grpProgs.visible=(modo3D==='progs');
    if(modo3D!=='progs')reconstruirMapa();
    else reconstruirProgs();
    if(trocaModo)window.__rpReset();
  };
  atualizarCena3D(true);

  var ray=new T.Raycaster(),ms=new T.Vector2(),dentro=false,mx=0,my=0,arr=false,panModo=false,ux=0,uy=0,mov=0,hover=null,raf=0;
  cv.addEventListener('contextmenu',function(e){e.preventDefault();});
  cv.addEventListener('wheel',function(e){
    e.preventDefault();e.stopPropagation();
    window.__rpZoom(e.deltaY>0?1.15:-1.15);
  },{passive:false});

  cv.addEventListener('pointermove',function(e){
    var r=cv.getBoundingClientRect();mx=e.clientX-r.left;my=e.clientY-r.top;
    ms.x=mx/r.width*2-1;ms.y=-(my/r.height)*2+1;dentro=true;
    if(arr){
      var dx=e.clientX-ux,dy=e.clientY-uy;ux=e.clientX;uy=e.clientY;
      mov+=Math.abs(dx)+Math.abs(dy);
      if(panModo){
        var esc=dist*0.0018;
        panAlvoX=Math.max(-5,Math.min(5,panAlvoX-dx*esc));
        panAlvoZ=Math.max(-4,Math.min(4,panAlvoZ-dy*esc));
      }else{
        velY=dx*0.0075;palco.rotation.y+=velY;
        elevAlvo=Math.max(0.28,Math.min(1.28,elevAlvo+dy*0.0045));
      }
    }
  });
  cv.addEventListener('pointerdown',function(e){
    arr=true;panModo=(e.button===2||e.shiftKey);ux=e.clientX;uy=e.clientY;mov=0;velY=0;
    try{cv.setPointerCapture(e.pointerId);}catch(err){}
  });
  cv.addEventListener('pointerup',function(){
    arr=false;
    if(mov<6&&hover){
      var u=hover.userData;
      if(u.tipo==='prog')irPara(u.d.s);
      else if(u.tipo==='mun'){
        if(munAtivo===u.e.mun){munAtivo='';munLabel='';}
        else{munAtivo=u.e.mun;munLabel=u.e.raw;}
        filtrar();
      }else if(u.tipo==='meso'||u.tipo==='meso-bar'){
        mesoAtiva=(mesoAtiva===u.idx)?-1:u.idx;
        filtrar();
      }
    }
  });
  cv.addEventListener('pointerleave',function(){dentro=false;arr=false;});
  cv.addEventListener('dblclick',function(){window.__rpReset();});

  function loop(){
    if(!cv.isConnected){window.__rp3d();return;}
    raf=requestAnimationFrame(loop);

    /* Interpolação suave de Câmera */
    panX+=(panAlvoX-panX)*0.12;
    panZ+=(panAlvoZ-panZ)*0.12;
    dist+=(distAlvo-dist)*0.12;
    elev+=(elevAlvo-elev)*0.12;
    enquadrar();

    var w0=cv.clientWidth||520,h0=cv.clientHeight||212;
    if(w0!==W||h0!==H){W=w0;H=h0;ren.setSize(W,H,false);enquadrar();}
    if(dentro&&!arr){
      ray.setFromCamera(ms,cam);
      var alvos=(modo3D!=='progs')?barrasMun.concat(malhasMeso):barrasProg;
      var hit=ray.intersectObjects(alvos,false);
      hover=hit.length?hit[0].object:null;
    }else if(!dentro)hover=null;

    if(modo3D!=='progs'){
      barrasMun.forEach(function(m){
        var u=m.userData,ativo=(m===hover)||(u.tipo==='mun'&&munAtivo&&u.e.mun===munAtivo)||(u.tipo==='meso-bar'&&mesoAtiva===u.idx);
        u.hy+=(u.h-u.hy)*0.18;
        u.s+=(((ativo?1.42:1)*(u.w||1))-u.s)*0.2;
        m.scale.set(u.s,Math.max(0.05,u.hy),u.s);
        m.material.emissiveIntensity+=((ativo?0.78:0.28)-m.material.emissiveIntensity)*0.18;
        if(u.lb)u.lb.position.y=(u.yBase||0.25)+m.scale.y+0.26;
      });
      malhasMeso.forEach(function(m,idx){
        var u=m.userData,ativo=(m===hover)||(mesoAtiva===idx);
        var alvoS=u.hAlvo||1;
        u.hy+=(alvoS-u.hy)*0.18;
        m.scale.y=u.hy;
        m.position.y+=((ativo?0.06:0)-m.position.y)*0.2;
        if(bordasMeso[idx])bordasMeso[idx].position.y=m.position.y+0.24*u.hy+0.02;
      });
      if(!arr&&Math.abs(velY)>0.0002){palco.rotation.y+=velY;velY*=0.9;}
    }else{
      barrasProg.forEach(function(m){
        var u=m.userData,naDir=dirOk(u.d.d),ativo=(m===hover)||(realce&&u.d.s===realce);
        var alvoH=u.h;
        u.hy+=(alvoH-u.hy)*0.16;
        u.s+=((ativo?1.25:(naDir?1:0.85))-u.s)*0.18;
        m.scale.set(u.s,Math.max(0.04,u.hy),u.s);
        if(u.lb){
          u.lb.position.y=m.scale.y+0.28;
          u.lb.material.opacity+=((naDir&&u.d.q>0?0.95:0)-u.lb.material.opacity)*0.15;
        }
        m.material.opacity+=((naDir?(u.d.q>0?1:0.22):0.15)-m.material.opacity)*0.15;
        m.material.emissiveIntensity+=((ativo?0.65:(naDir&&u.d.q>0?0.22:0.02))-m.material.emissiveIntensity)*0.15;
      });
      if(!arr){
        if(Math.abs(velY)>0.0002){palco.rotation.y+=velY;velY*=0.92;}
        else if(!hover&&!realce)palco.rotation.y+=0.0014;
      }
    }

    if(hover){
      var u=hover.userData;
      if(u.tipo==='mun'){
        var e=u.e,vt=e.v>0?('<span class=tv>'+fmtBRL(e.v)+'</span>'):'';
        var ds=['DPD','DCTT','DIPRO','DIAE'].filter(function(k){return e.porDir[k]>0;}).map(function(k){return k+': '+e.porDir[k];}).join(' · ');
        tip.innerHTML='<b><i style=background:'+u.c+'></i>'+e.raw+'<em>'+(MG_MESOS[e.mi]?MG_MESOS[e.mi].n:'MG')+'</em></b>'+e.q.toLocaleString('pt-BR')+' projeto(s)'+(ds?' ('+ds+')':'')+vt+'<small>Clique para filtrar este município</small>';
        cv.style.cursor='pointer';
      }else if(u.tipo==='meso'||u.tipo==='meso-bar'){
        var vt2=u.v>0?('<span class=tv>'+fmtBRL(u.v)+'</span>'):'';
        var ds2=u.porDir?['DPD','DCTT','DIPRO','DIAE'].filter(function(k){return u.porDir[k]>0;}).map(function(k){return k+': '+u.porDir[k];}).join(' · '):'';
        tip.innerHTML='<b><i style=background:'+(u.c||'#38bdf8')+'></i>'+u.n+'<em>Mesorregião</em></b>'+u.q.toLocaleString('pt-BR')+' projeto(s) em '+u.muns+' município(s)'+(ds2?' ('+ds2+')':'')+vt2+'<small>Clique para filtrar esta região</small>';
        cv.style.cursor='pointer';
      }else if(u.tipo==='prog'){
        var d=u.d;
        var vt3=d.v>0?('<span class=tv>'+fmtBRL(d.v)+'</span>'):(d.s==='s17'?'<span class=tv>Acordo de Cooperação Técnica</span>':'');
        var subTxt=munAtivo?('em '+munLabel):((mesoAtiva>=0&&MG_MESOS[mesoAtiva])?('em '+MG_MESOS[mesoAtiva].n):'no Estado');
        tip.innerHTML='<b><i style=background:'+d.c+'></i>'+d.n+'<em>'+d.d+'</em></b>'+d.q.toLocaleString('pt-BR')+' projeto(s) '+subTxt+vt3+'<small>(Geral: '+d.qGeral+' projetos) · Clique para rolar até a seção</small>';
        cv.style.cursor='pointer';
      }
      tip.classList.add('on');
      tip.style.left=mx+'px';tip.style.top=my+'px';
    }else{
      tip.classList.remove('on');cv.style.cursor=arr?'grabbing':'grab';
    }
    ren.render(cena,cam);
  }
  loop();

  window.__rp3d=function(){
    cancelAnimationFrame(raf);
    cv.removeEventListener('pointermove',arguments.callee);
    if(ren){try{ren.dispose();}catch(e){}}
  };
  window.__rpResize=function(){
    W=cv.clientWidth||520;H=cv.clientHeight||212;
    ren.setSize(W,H,false);enquadrar();
  };
  window.addEventListener('resize',window.__rpResize);
}

if(window.THREE){iniciar3D();}
else if(typeof THREE!=='undefined'){window.THREE=THREE;iniciar3D();}
else{
  var s=document.createElement('script');
  s.src='https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
  s.async=true;
  s.onload=function(){if(typeof THREE!=='undefined')window.THREE=THREE;iniciar3D();};
  s.onerror=grafico2D;
  document.head.appendChild(s);
  setTimeout(function(){if(!window.THREE&&typeof THREE!=='undefined')window.THREE=THREE;if(window.THREE)iniciar3D();else grafico2D();},2000);
}
})();"

RETURN
"<svg style='display:none'><defs><g id='icp'><rect x='9' y='9' width='13' height='13' rx='2' fill='none' stroke='currentColor' stroke-width='2'/><path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1' fill='none' stroke='currentColor' stroke-width='2'/></g></defs></svg>" &
"<div id='rp' data-total='" & QtdTotal & "' data-progs='" & QtdProgramas & "' data-muns='" & QtdMunicipios & "' data-valor='" & ValorConcedente & "' data-aprov='" & ValorAprovado & "'>" &
    "<style>" & CSS & "</style>" &

    -- ===== Hero Superior Unificado (KPIs + Controles de Diretoria + Mapa 3D Integrado) =====
    "<div class='hero'>" &
        "<div class='hero-info'>" &
            "<div class='eyebrow'>" &
                "<span>SUBINOVA · Monitor Executivo</span>" &
                "<button type='button' class='fbadge' data-act='limpar-tudo' title='Remover todos os filtros aplicados'>✕ Limpar filtros</button>" &
            "</div>" &
            "<div class='geo-strip'>" &
                "<div class='geo-kpi'><span>Município</span><b id='rp-gmun'>Todos</b></div>" &
                "<div class='geo-kpi'><span>Mesorregião</span><b id='rp-gmeso'>Todas as 12</b></div>" &
            "</div>" &
            "<div class='hero-kpis'>" &
                "<div class='hk'><span>Projetos</span><b id='rp-kp'>" & FORMAT ( QtdTotal, "#,##0", "pt-BR" ) & "</b><small>distribuídos</small></div>" &
                "<div class='hk'><span>Programas</span><b id='rp-kg'>" & QtdProgramas & "</b><small>em 4 diretorias</small></div>" &
                "<div class='hk val'>" &
                    "<span id='rp-kvl'>Valor Concedente</span>" &
                    "<b id='rp-kv'>" & ValorConcedente & "</b>" &
                    "<small id='rp-ks'></small>" &
                "</div>" &
                "<div class='hk val aprov'>" &
                    "<span id='rp-kavl'>Total com Contrapartida</span>" &
                    "<b id='rp-kav'>" & ValorAprovado & "</b>" &
                    "<small id='rp-kas'>Aporte global aprovado</small>" &
                "</div>" &
            "</div>" &
            "<div class='fs-dirs'>" &
                "<div class='fs-dirs-lbl'>Diretorias (clique p/ filtrar)</div>" &
                "<div class='fs-dirs-row'>" &
                    "<button type='button' class='fs-dir' data-dir='DPD'><i style='background:#2563eb'></i>DPD</button>" &
                    "<button type='button' class='fs-dir' data-dir='DCTT'><i style='background:#0891b2'></i>DCTT</button>" &
                    "<button type='button' class='fs-dir' data-dir='DIPRO'><i style='background:#0d9488'></i>DIPRO</button>" &
                    "<button type='button' class='fs-dir' data-dir='DIAE'><i style='background:#4f46e5'></i>DIAE</button>" &
                "</div>" &
            "</div>" &
            "<div class='hint'>Arraste p/ girar · Scroll p/ zoom · Clique em município ou região p/ filtrar</div>" &
        "</div>" &
        "<div class='viz'>" &
            "<div class='viz-top'>" &
                "<div class='vmodes'>" &
                    "<button type='button' class='vm on' data-vm='mun' title='Mapa 3D por Município'>Por Município</button>" &
                    "<button type='button' class='vm' data-vm='meso' title='Mapa 3D por Mesorregião'>Por Região</button>" &
                    "<button type='button' class='vm' data-vm='progs' title='Matriz Arquitetônica das 4 Diretorias'>Programas 3D</button>" &
                "</div>" &
                "<div class='leg3d'>" &
                    "<span><i style='background:#2563eb'></i>DPD</span>" &
                    "<span><i style='background:#0891b2'></i>DCTT</span>" &
                    "<span><i style='background:#0d9488'></i>DIPRO</span>" &
                    "<span><i style='background:#4f46e5'></i>DIAE</span>" &
                "</div>" &
            "</div>" &
            "<canvas id='rp-3d'></canvas>" &
            "<div class='vtools'>" &
                "<button type='button' class='vt' data-act='zin' title='Aproximar zoom (+)'>+</button>" &
                "<button type='button' class='vt' data-act='zout' title='Afastar zoom (−)'>−</button>" &
                "<button type='button' class='vt' data-act='zreset' title='Restaurar visão original'>Reset</button>" &
                "<button type='button' class='vt' data-act='fs3d' title='Alternar modo tela cheia do mapa 3D'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><polyline points='15 3 21 3 21 9'/><polyline points='9 21 3 21 3 15'/><line x1='21\' y1='3\' x2='14\' y2='10\'/><line x1='3\' y1='21\' x2='10\' y2='14\'/></svg>Expandir 3D</button>" &
            "</div>" &
            "<div id='rp-tip' class='tip'></div>" &
            "<div class='bars2d'></div>" &
        "</div>" &
    "</div>" &

    -- ===== Barra de Ferramentas / Filtros Rápidos =====
    "<div class='bar'>" &
        "<div class='bar-l'>" &
            "<div class='dir-group'>" & BotoesDiretoria & "</div>" &
            "<div class='sep'></div>" &
            "<select id='rp-ord' class='ord' title='Ordenar projetos nos cartões'>" &
                "<option value='padrao'>Ordem padrão</option>" &
                "<option value='maior'>Maior valor (R$)</option>" &
                "<option value='menor'>Menor valor (R$)</option>" &
                "<option value='mun'>Município (A-Z)</option>" &
                "<option value='az'>Título (A-Z)</option>" &
            "</select>" &
        "</div>" &
        "<div class='bar-r'>" &
            "<button class='btn' type='button' data-act='abrir' title='Expandir todos os programas'>Expandir</button>" &
            "<button class='btn' type='button' data-act='fechar' title='Recolher todos os programas'>Recolher</button>" &
            "<button class='btn graf' type='button' data-act='grafico' title='Abrir painel comparativo por município'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>Abrir Gráfico</button>" &
            "<button class='btn' type='button' data-act='texto' title='Copiar relatório institucional formal para colar no Word (Ctrl+V)'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/><polyline points='10 9 9 9 8 9'/></svg>Texto (Word)</button>" &
            "<button class='btn prim' type='button' data-act='excel' title='Copiar tabela estruturada para colar no Excel'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='9' y='9' width='13' height='13' rx='2'/><path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'/></svg>Excel</button>" &
        "</div>" &
    "</div>" &

    "<div class='subbar'>" &
        "<div class='busca-wrap'>" &
            "<svg class='busca-i' width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>" &
            "<input id='rp-q' class='q' type='text' autocomplete='off' placeholder='Filtrar por projeto, município, proponente, coordenador...'>" &
            "<button class='q-x' type='button' data-act='limpar' title='Limpar busca'>✕</button>" &
        "</div>" &
        "<div class='filter-tags'>" &
            "<div id='rp-cnt' class='cnt'></div>" &
            "<div class='ftags'>" &
                "<button type='button' id='rp-mesotag' class='ftag' data-act='limpar-meso' title='Remover filtro regional'></button>" &
                "<button type='button' id='rp-muntag' class='ftag' data-act='limpar-mun' title='Remover filtro de município'></button>" &
            "</div>" &
        "</div>" &
    "</div>" &

    -- ===== Painel Analítico por Município (Abrir Gráfico) =====
    "<section id='rp-gmodal' class='gmodal'>" &
        "<div class='gm-head'>" &
            "<div class='gm-title'><svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#0284c7' stroke-width='2.2'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>Análise Comparativa por Município <small>(clique em qualquer município para filtrar no mapa e nos dados)</small></div>" &
            "<button type='button' class='gm-close' data-act='fechar-grafico'>Fechar gráfico ✕</button>" &
        "</div>" &
        "<div class='gm-kpis'>" &
            "<div class='gm-kpi'><span>Total filtrado</span><b id='gm-k1'>—</b></div>" &
            "<div class='gm-kpi'><span>Municípios</span><b id='gm-k2'>—</b></div>" &
            "<div class='gm-kpi'><span>Mais projetos</span><b id='gm-k3'>—</b></div>" &
            "<div class='gm-kpi'><span>Maior aporte</span><b id='gm-k4'>—</b></div>" &
        "</div>" &
        "<div class='gm-body'>" &
            "<div id='gm-chart' class='gm-chart'></div>" &
        "</div>" &
    "</section>" &

    -- ===== Quadro Sintético das 4 Diretorias (DPD, DCTT, DIPRO, DIAE) + Observação Metodológica =====
    "<section class='dash'>" &
        "<div id='rp-dirgrid' class='dir-grid'></div>" &
        "<div class='obs-bar'><b>Observação:</b> O valor contratado é superior ao solicitado devido à ausência de dados de solicitação em determinados editais e projetos. Além disso, os programas Pró-Inovação, PCTI e Incremento da Maturidade contabilizam exclusivamente valores contratados, e o valor total via TecPop foi rateado igualmente entre os municípios atendidos.</div>" &
    "</section>" &

    -- ===== Conteúdo principal (Municípios + Seções de Cartões de Projetos) =====
    "<div class='area'>" &
        TermosBox &
        "<details class='box muns'" & IF ( QtdMunicipios <= 35, " open", "" ) & ">" &
            "<summary class='sh'>Municípios contemplados <span class='pill'>" & QtdMunicipios & "</span><small>Clique em um município para filtrar</small><span class='chev'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2'><polyline points='6 9 12 15 18 9'/></svg></span></summary>" &
            IF ( QtdMunicipios > 20, "<div class='mun-tools'><input id='rp-munq' class='mun-q' type='text' autocomplete='off' placeholder='Localizar município na lista…'></div>", "" ) &
            "<div class='mun-list'>" &
                CONCATENATEX ( MunicipiosLimpos, "<button type='button' class='mun' data-mun='" & [Município] & "'>" & [Município] & "</button>", "", [Município], ASC ) &
            "</div>" &
        "</details>" &
        IF (
            QtdTotal >= 1,
            "<div class='box resumo'>" &
                "<p id='rp-rtxt'>Distribuição dos <b>" & FORMAT ( QtdTotal, "#,##0", "pt-BR" ) & "</b> projetos por programa:</p>" &
                "<div class='chips'>" & Chips & "</div>" &
            "</div>" &
            Secoes,
            "<div class='empty'><b>Nenhum projeto encontrado</b><br>Ajuste os filtros selecionados no painel ou os termos de busca.</div>"
        ) &
        "<div id='rp-empty' class='empty' style='display:none'><b>Nenhum registro encontrado</b><br>Nenhum projeto corresponde aos filtros locais aplicados.</div>" &
        "<div id='rp-tot' class='total'><span>Valor Concedente Total: <b>" & ValorConcedente & "</b></span><span>Total Aprovado (c/ Contrapartida): <b>" & ValorAprovado & "</b></span></div>" &
    "</div>" &

    "<button class='topo' type='button' data-act='topo' title='Voltar ao topo'>▲</button>" &
    "<div class='toast'></div>" &
    "<script>window.RP_DATA=" & DadosJS & ";" & JS & "</script>" &
"</div>"